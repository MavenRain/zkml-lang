-- Sample domain. Replace it with your design. See domain/README.md.
-- Each family, constructor, field and def name here becomes a core name
-- (rule R4). Only this file can declare a family (rule R1).
family Color := red | green | blue
family Item := makeItem (itemColor : Color) (itemPrice : Nat) (itemCount : Nat)
family Stack := bottom | push (top : Nat) (rest : Stack)
-- A tree: a fold over a tree that exists at run time is a HOST-LIMIT.
family Tree := tip | fork (forkLeft : Tree) (forkRight : Tree)
-- An indexed family (former F15): `Lot 3` is a lot of size 3.
family Lot (size : Nat) := makeLot (lotPrice : Nat)

def lineTotal : (item : Item) -> Nat :=
  fun (item : Item) => natMul (itemPrice item) (itemCount item)
def isRed : (color : Color) -> Flag :=
  fun (color : Color) => fold flagYes flagNo flagNo color
def total : (items : List Item) -> Nat :=
  fun (items : List Item) => fold (fun (item : Item) (acc : Nat) => natAdd (lineTotal item) acc) 0 items
def redTotal : (items : List Item) -> Nat :=
  fun (items : List Item) => total (filter (fun (item : Item) => isRed (itemColor item)) items)
def depth : (s : Stack) -> Nat :=
  fun (s : Stack) => fold 0 (fun (top : Nat) (rest : Nat) => natAdd rest 1) s
-- Higher inductive types (former C4): a constructor with a Path type is a path.
family Circle := circleBase | circleLoop : Path Circle circleBase circleBase
family Trunc (A : Type 0) := truncIn (truncVal : A)
  | truncSquash (truncX truncY : Trunc A) : Path (Trunc A) truncX truncY
family Quot (A : Type 0) (R : A -> A -> Type 0) := quotIn (quotRep : A)
  | quotGlue (quotA quotB : A) (quotR : R quotA quotB) : Path (Quot A R) (quotIn A R quotA) (quotIn A R quotB)
  | quotSquash (quotX quotY : Quot A R) (quotP quotQ : Path (Quot A R) quotX quotY) : Path (Path (Quot A R) quotX quotY) quotP quotQ
-- Quotient inductive-inductive types (former C5): Circuit is indexed by Shape.
-- Each point constructor states its result; the header binders are the index telescope.
-- Field names are domain-wide projection names (rule R4), so each constructor has its own.
-- circOp is one operator. circResidual f is x + f x (Circuit has no products).
family Shape := shape (dims : List Nat)
-- Operators (Z6e): Op a b is a primitive step from the shape a to the shape b,
-- with one constructor for each operator. opQuantize s k divides each entry by
-- 2^k. opMatMul n m k (Z6f) multiplies by the matrix k of the weights (O4):
-- bbRun reads the weights from the witness. opLookup s t (Z6f) applies the
-- table t of the weights to each entry. opSoftmax s t k and opLayerNorm s g t
-- (Z6f) operate on each row of the last dim. opAttention h d q k v t e (Z6g)
-- maps [h, d] to [h, d] with one head (O5).
family Op (a b : Shape) :=
    opQuantize (qzS : Shape) (qzK : Nat) : Op qzS qzS
  | opMatMul (mmN mmM mmK : Nat) : Op (shape (cons mmN nil)) (shape (cons mmM nil))
  | opLookup (lkS : Shape) (lkT : Nat) : Op lkS lkS
  | opSoftmax (smS : Shape) (smT smK : Nat) : Op smS smS
  | opLayerNorm (lnS : Shape) (lnG lnT : Nat) : Op lnS lnS
  | opAttention (atH atD atQ atK atV atT atE : Nat) : Op (shape (cons atH (cons atD nil))) (shape (cons atH (cons atD nil)))
family Circuit (a b : Shape) :=
    circId (idA : Shape) : Circuit idA idA
  | circSeq (seqA seqB seqC : Shape) (seqF : Circuit seqA seqB) (seqG : Circuit seqB seqC) : Circuit seqA seqC
  | circOp (opA opB : Shape) (opO : Op opA opB) : Circuit opA opB
  | circResidual (rsS : Shape) (rsF : Circuit rsS rsS) : Circuit rsS rsS
  | circIdl (idlA idlB : Shape) (idlF : Circuit idlA idlB)
      : Path (Circuit idlA idlB) (circSeq idlA idlA idlB (circId idlA) idlF) idlF
  | circIdr (idrA idrB : Shape) (idrF : Circuit idrA idrB)
      : Path (Circuit idrA idrB) (circSeq idrA idrB idrB idrF (circId idrB)) idrF
  | circAssoc (asA asB asC asD : Shape) (asF : Circuit asA asB) (asG : Circuit asB asC) (asH : Circuit asC asD)
      : Path (Circuit asA asD) (circSeq asA asC asD (circSeq asA asB asC asF asG) asH) (circSeq asA asB asD asF (circSeq asB asC asD asG asH))
  | circSquash (sqA sqB : Shape) (sqF sqG : Circuit sqA sqB) (sqP sqQ : Path (Circuit sqA sqB) sqF sqG)
      : Path (Path (Circuit sqA sqB) sqF sqG) sqP sqQ

family Rose := rose (roseKids : Kids)
  and Kids := kidsNil | kidsCons (kidsHead : Rose) (kidsTail : Kids)
  | kidsSwap (swapX swapY : Rose) (swapK : Kids) : Path Kids (kidsCons swapX (kidsCons swapY swapK)) (kidsCons swapY (kidsCons swapX swapK))
  | kidsSquash (ksqK ksqL : Kids) (ksqP ksqQ : Path Kids ksqK ksqL) : Path (Path Kids ksqK ksqL) ksqP ksqQ

-- Nat lemmas (slice Z5). Each is a proof by Nat induction: a fold with a motive.
def natAddAssoc : (a : Nat) -> (b : Nat) -> (c : Nat) -> Path Nat (natAdd (natAdd a b) c) (natAdd a (natAdd b c)) :=
  fun a b c => fold (fun (c : Nat) => Path Nat (natAdd (natAdd a b) c) (natAdd a (natAdd b c))) (fun (k : Nat) => fun (ih : Path Nat (natAdd (natAdd a b) k) (natAdd a (natAdd b k))) => cong (fun (z : Nat) => natAdd z 1) ih) refl c
def natMaxAssoc : (a : Nat) -> (b : Nat) -> (c : Nat) -> Path Nat (natMax (natMax a b) c) (natMax a (natMax b c)) :=
  fun a => fold (fun (a : Nat) => (b : Nat) -> (c : Nat) -> Path Nat (natMax (natMax a b) c) (natMax a (natMax b c))) (fun (k : Nat) => fun (ih : (b : Nat) -> (c : Nat) -> Path Nat (natMax (natMax k b) c) (natMax k (natMax b c))) => fun (b : Nat) => fold (fun (b : Nat) => (c : Nat) -> Path Nat (natMax (natMax (natAdd k 1) b) c) (natMax (natAdd k 1) (natMax b c))) (fun (j : Nat) => fun (ihb : (c : Nat) -> Path Nat (natMax (natMax (natAdd k 1) j) c) (natMax (natAdd k 1) (natMax j c))) => fun (c : Nat) => fold (fun (c : Nat) => Path Nat (natMax (natMax (natAdd k 1) (natAdd j 1)) c) (natMax (natAdd k 1) (natMax (natAdd j 1) c))) (fun (i : Nat) => fun (ihc : Path Nat (natMax (natMax (natAdd k 1) (natAdd j 1)) i) (natMax (natAdd k 1) (natMax (natAdd j 1) i))) => cong (fun (z : Nat) => natAdd z 1) (ih j i)) refl c) (fun (c : Nat) => refl) b) (fun (b : Nat) => fun (c : Nat) => refl) a
-- Resource (N1): the cost of a layer. resAdd adds the gates and the lookups and
-- takes the larger degree. The unit laws hold by refl (the natAdd and natMax
-- neutral rules and record eta). resAssoc joins the three component paths.
family Resource := res (resGates resLookups resDegree : Nat)
def zeroR : Resource := res 0 0 0
def resAdd : (r : Resource) -> (s : Resource) -> Resource :=
  fun (r : Resource) (s : Resource) => res (natAdd (resGates r) (resGates s)) (natAdd (resLookups r) (resLookups s)) (natMax (resDegree r) (resDegree s))
def resUnitL : (r : Resource) -> Path Resource (resAdd zeroR r) r :=
  fun (r : Resource) => refl
def resUnitR : (r : Resource) -> Path Resource (resAdd r zeroR) r :=
  fun (r : Resource) => refl
def resAssoc : (r : Resource) -> (s : Resource) -> (t : Resource) -> Path Resource (resAdd (resAdd r s) t) (resAdd r (resAdd s t)) :=
  fun (r : Resource) (s : Resource) (t : Resource) => <i> res ((natAddAssoc (resGates r) (resGates s) (resGates t)) @ i) ((natAddAssoc (resLookups r) (resLookups s) (resLookups t)) @ i) ((natMaxAssoc (resDegree r) (resDegree s) (resDegree t)) @ i)
-- A monoid with a carrier in Type 0. Monoid is in Type 1.
family Monoid := mkMonoid (monCarrier : Type 0) (monUnit : monCarrier) (monOp : monCarrier -> monCarrier -> monCarrier)
  (monAssoc : (x : monCarrier) -> (y : monCarrier) -> (z : monCarrier) -> Path monCarrier (monOp (monOp x y) z) (monOp x (monOp y z)))
  (monIdl : (x : monCarrier) -> Path monCarrier (monOp monUnit x) x)
  (monIdr : (x : monCarrier) -> Path monCarrier (monOp x monUnit) x)
def ResourceMonoid : Monoid := mkMonoid Resource zeroR resAdd resAssoc resUnitL resUnitR
-- Tensor A s: a nested List over A, with one List level for each dimension of s.
def Tensor : Type 0 -> Shape -> Type 0 :=
  fun (A : Type 0) (s : Shape) => fold (fun (d : Nat) (T : Type 0) => List T) A (dims s)
-- A set: two paths between the same two points are equal (slice Z5b).
def isSet : (B : Type 0) -> Type 0 := fun B => (x : B) -> (y : B) -> (p : Path B x y) -> (q : Path B x y) -> Path (Path B x y) p q
-- An instance (D7): the field, the witness, the weights (N7) and the circuit semantics.
-- The input witness fields (N3) give the completeness of idL. The weights are an argument, because completeness quantifies over the weights (N7).
-- The id and seq fields (N8) give the soundness and completeness of idL and layerSeq for an abstract instance.
family Inst := mkInst (instF : Type 0) (instWitness : Type 0) (instWeights : Type 0)
  (instWeightsOf : instWitness -> instWeights)
  (instSat : (a b : Shape) -> Circuit a b -> Tensor instF a -> instWitness -> Type 0)
  (instEval : (a b : Shape) -> Circuit a b -> instWitness -> Tensor instF b)
  (instInputWit : (s : Shape) -> instWeights -> Tensor instF s -> instWitness)
  (instInputWeights : (s : Shape) -> (ws : instWeights) -> (x : Tensor instF s) -> Path instWeights (instWeightsOf (instInputWit s ws x)) ws)
  (instInputSat : (s : Shape) -> (ws : instWeights) -> (x : Tensor instF s) -> instSat s s (circId s) x (instInputWit s ws x))
  (instInputEval : (s : Shape) -> (ws : instWeights) -> (x : Tensor instF s) -> Path (Tensor instF s) (instEval s s (circId s) (instInputWit s ws x)) x)
  (instIdSound : (s : Shape) -> (x : Tensor instF s) -> (w : instWitness) -> instSat s s (circId s) x w -> Path (Tensor instF s) x (instEval s s (circId s) w))
  (instSeqWit : (a b c : Shape) -> (f : Circuit a b) -> (g : Circuit b c) -> instWitness -> instWitness -> instWitness)
  (instSeqSat : (a b c : Shape) -> (f : Circuit a b) -> (g : Circuit b c) -> (x : Tensor instF a) -> (w : instWitness) -> instSat a c (circSeq a b c f g) x w -> Trunc (Sigma (u : instWitness) (Sigma (v : instWitness) (Prod (Path instWitness w (instSeqWit a b c f g u v)) (Prod (Path instWeights (instWeightsOf u) (instWeightsOf v)) (Prod (instSat a b f x u) (instSat b c g (instEval a b f u) v)))))))
  (instSeqWitWeights : (a b c : Shape) -> (f : Circuit a b) -> (g : Circuit b c) -> (u v : instWitness) -> Path instWeights (instWeightsOf u) (instWeightsOf v) -> Path instWeights (instWeightsOf (instSeqWit a b c f g u v)) (instWeightsOf u))
  (instSeqWitSat : (a b c : Shape) -> (f : Circuit a b) -> (g : Circuit b c) -> (x : Tensor instF a) -> (u v : instWitness) -> Path instWeights (instWeightsOf u) (instWeightsOf v) -> instSat a b f x u -> instSat b c g (instEval a b f u) v -> instSat a c (circSeq a b c f g) x (instSeqWit a b c f g u v))
  (instSeqWitEval : (a b c : Shape) -> (f : Circuit a b) -> (g : Circuit b c) -> (u v : instWitness) -> Path (Tensor instF c) (instEval a c (circSeq a b c f g) (instSeqWit a b c f g u v)) (instEval b c g v))
  (instTensorSet : (s : Shape) -> isSet (Tensor instF s))
-- The completeness witness of a layer at the weights ws and the input x: a witness with the weights ws
-- that satisfies the circuit at x, and the circuit value of the witness is the denotation.
def layerWit : (I : Inst) -> (a b : Shape) -> (f : Circuit a b) -> (den : instWeights I -> Tensor (instF I) a -> Tensor (instF I) b) -> (ws : instWeights I) -> (x : Tensor (instF I) a) -> Type 0 :=
  fun I a b f den ws x => Sigma (w : instWitness I) (Prod (Path (instWeights I) (instWeightsOf I w) ws) (Prod (instSat I a b f x w) (Path (Tensor (instF I) b) (den ws x) (instEval I a b f w))))
-- A layer (D8): a circuit, a denotation over the weights (N7), soundness, completeness and resources.
family Layer (I : Inst) (inS outS : Shape) := layer (layerCircuit : Circuit inS outS)
  (layerDen : instWeights I -> Tensor (instF I) inS -> Tensor (instF I) outS)
  (layerSound : (x : Tensor (instF I) inS) -> (w : instWitness I) -> instSat I inS outS layerCircuit x w -> Path (Tensor (instF I) outS) (layerDen (instWeightsOf I w) x) (instEval I inS outS layerCircuit w))
  (layerComplete : (ws : instWeights I) -> (x : Tensor (instF I) inS) -> Trunc (layerWit I inS outS layerCircuit layerDen ws x))
  (layerRes : Resource)
-- The identity layer: the circuit circId, the identity denotation and zero resources.
def idL : (I : Inst) -> (s : Shape) -> Layer I s s :=
  fun I s => layer I s s (circId s) (fun (ws : instWeights I) (x : Tensor (instF I) s) => x)
    (fun (x : Tensor (instF I) s) (w : instWitness I) (h : instSat I s s (circId s) x w) => instIdSound I s x w h)
    (fun (ws : instWeights I) (x : Tensor (instF I) s) => truncIn (layerWit I s s (circId s) (fun (vs : instWeights I) (y : Tensor (instF I) s) => y) ws x) (pack (instInputWit I s ws x) (pair (instInputWeights I s ws x) (pair (instInputSat I s ws x) (symm (instInputEval I s ws x))))))
    zeroR
-- The denotation of layerSeq: first L1, then L2, with the same weights.
def seqDen : (I : Inst) -> (a b c : Shape) -> (L2 : Layer I b c) -> (L1 : Layer I a b) -> instWeights I -> Tensor (instF I) a -> Tensor (instF I) c :=
  fun I a b c L2 L1 ws x => layerDen L2 ws (layerDen L1 ws x)
-- The soundness of layerSeq at a split w = instSeqWit u v with the same weights in u and v (flag 16 (a)):
-- soundness of L1 at u, then soundness of L2 at the circuit value of L1 and v, then instSeqWitEval.
def soundnessSplit : (I : Inst) -> (a b c : Shape) -> (L2 : Layer I b c) -> (L1 : Layer I a b) -> (x : Tensor (instF I) a) -> (w : instWitness I) -> (u v : instWitness I) -> Path (instWitness I) w (instSeqWit I a b c (layerCircuit L1) (layerCircuit L2) u v) -> Path (instWeights I) (instWeightsOf I u) (instWeightsOf I v) -> instSat I a b (layerCircuit L1) x u -> instSat I b c (layerCircuit L2) (instEval I a b (layerCircuit L1) u) v -> Path (Tensor (instF I) c) (seqDen I a b c L2 L1 (instWeightsOf I w) x) (instEval I a c (circSeq a b c (layerCircuit L1) (layerCircuit L2)) w) :=
  fun I a b c L2 L1 x w u v p q hu hv => trans (cong (fun (k : instWeights I) => layerDen L2 k (layerDen L1 (instWeightsOf I w) x)) (trans (trans (cong (fun (z : instWitness I) => instWeightsOf I z) p) (instSeqWitWeights I a b c (layerCircuit L1) (layerCircuit L2) u v q)) q))
    (trans (cong (fun (y : Tensor (instF I) b) => layerDen L2 (instWeightsOf I v) y) (trans (cong (fun (k : instWeights I) => layerDen L1 k x) (trans (cong (fun (z : instWitness I) => instWeightsOf I z) p) (instSeqWitWeights I a b c (layerCircuit L1) (layerCircuit L2) u v q))) (layerSound L1 x u hu)))
      (trans (layerSound L2 (instEval I a b (layerCircuit L1) u) v hv) (symm (trans (cong (fun (z : instWitness I) => instEval I a c (circSeq a b c (layerCircuit L1) (layerCircuit L2)) z) p) (instSeqWitEval I a b c (layerCircuit L1) (layerCircuit L2) u v)))))
-- The soundness of layerSeq (N8): instSeqSat gives a truncated split, and the goal is a path in a set,
-- so the fold over the Trunc goes into the goal. instTensorSet at the two ends is the proof that the goal is a proposition.
def soundnessSeq : (I : Inst) -> (a b c : Shape) -> (L2 : Layer I b c) -> (L1 : Layer I a b) -> (x : Tensor (instF I) a) -> (w : instWitness I) -> instSat I a c (circSeq a b c (layerCircuit L1) (layerCircuit L2)) x w -> Path (Tensor (instF I) c) (seqDen I a b c L2 L1 (instWeightsOf I w) x) (instEval I a c (circSeq a b c (layerCircuit L1) (layerCircuit L2)) w) :=
  fun I a b c L2 L1 x w h => fold (fun (s : Sigma (u : instWitness I) (Sigma (v : instWitness I) (Prod (Path (instWitness I) w (instSeqWit I a b c (layerCircuit L1) (layerCircuit L2) u v)) (Prod (Path (instWeights I) (instWeightsOf I u) (instWeightsOf I v)) (Prod (instSat I a b (layerCircuit L1) x u) (instSat I b c (layerCircuit L2) (instEval I a b (layerCircuit L1) u) v)))))) => soundnessSplit I a b c L2 L1 x w (witness s) (witness (payload s)) (first (payload (payload s))) (first (second (payload (payload s)))) (first (second (second (payload (payload s))))) (second (second (second (payload (payload s))))))
    (instTensorSet I c (seqDen I a b c L2 L1 (instWeightsOf I w) x) (instEval I a c (circSeq a b c (layerCircuit L1) (layerCircuit L2)) w)) (instSeqSat I a b c (layerCircuit L1) (layerCircuit L2) x w h)
-- The witness of layerSeq from a witness of L1 and a witness of L2 (instSeqWit and its laws, N8).
def seqWitness : (I : Inst) -> (a b c : Shape) -> (L2 : Layer I b c) -> (L1 : Layer I a b) -> (ws : instWeights I) -> (x : Tensor (instF I) a) -> (s1 : layerWit I a b (layerCircuit L1) (layerDen L1) ws x) -> (s2 : layerWit I b c (layerCircuit L2) (layerDen L2) ws (layerDen L1 ws x)) -> layerWit I a c (circSeq a b c (layerCircuit L1) (layerCircuit L2)) (seqDen I a b c L2 L1) ws x :=
  fun I a b c L2 L1 ws x s1 s2 => pack (instSeqWit I a b c (layerCircuit L1) (layerCircuit L2) (witness s1) (witness s2))
    (pair (trans (instSeqWitWeights I a b c (layerCircuit L1) (layerCircuit L2) (witness s1) (witness s2) (trans (first (payload s1)) (symm (first (payload s2))))) (first (payload s1)))
      (pair (instSeqWitSat I a b c (layerCircuit L1) (layerCircuit L2) x (witness s1) (witness s2) (trans (first (payload s1)) (symm (first (payload s2)))) (first (second (payload s1))) (transp (fun i => instSat I b c (layerCircuit L2) ((second (second (payload s1))) @ i) (witness s2)) i0 (first (second (payload s2)))))
        (trans (second (second (payload s2))) (symm (instSeqWitEval I a b c (layerCircuit L1) (layerCircuit L2) (witness s1) (witness s2))))))
-- The completeness of layerSeq: a map of two truncations into a truncation.
def completenessSeq : (I : Inst) -> (a b c : Shape) -> (L2 : Layer I b c) -> (L1 : Layer I a b) -> (ws : instWeights I) -> (x : Tensor (instF I) a) -> Trunc (layerWit I a c (circSeq a b c (layerCircuit L1) (layerCircuit L2)) (seqDen I a b c L2 L1) ws x) :=
  fun I a b c L2 L1 ws x => fold (fun (s1 : layerWit I a b (layerCircuit L1) (layerDen L1) ws x) => fold (fun (s2 : layerWit I b c (layerCircuit L2) (layerDen L2) ws (layerDen L1 ws x)) => truncIn (layerWit I a c (circSeq a b c (layerCircuit L1) (layerCircuit L2)) (seqDen I a b c L2 L1) ws x) (seqWitness I a b c L2 L1 ws x s1 s2))
      (truncSquash (layerWit I a c (circSeq a b c (layerCircuit L1) (layerCircuit L2)) (seqDen I a b c L2 L1) ws x)) (layerComplete L2 ws (layerDen L1 ws x)))
    (truncSquash (layerWit I a c (circSeq a b c (layerCircuit L1) (layerCircuit L2)) (seqDen I a b c L2 L1) ws x)) (layerComplete L1 ws x)
-- Sequential composition (D9), design order: layerSeq I a b c L2 L1 is first L1, then L2.
def layerSeq : (I : Inst) -> (a b c : Shape) -> (L2 : Layer I b c) -> (L1 : Layer I a b) -> Layer I a c :=
  fun I a b c L2 L1 => layer I a c (circSeq a b c (layerCircuit L1) (layerCircuit L2)) (seqDen I a b c L2 L1)
    (soundnessSeq I a b c L2 L1) (completenessSeq I a b c L2 L1) (resAdd (layerRes L2) (layerRes L1))
-- The resources of layerSeq are the sum of the resources of the two layers.
def resourcesSeq : (I : Inst) -> (a b c : Shape) -> (L2 : Layer I b c) -> (L1 : Layer I a b) -> Path Resource (layerRes (layerSeq I a b c L2 L1)) (resAdd (layerRes L2) (layerRes L1)) :=
  fun I a b c L2 L1 => refl
-- h-levels (D10). A proposition has a path between any two of its elements.
def isProp : (A : Type 0) -> Type 0 := fun A => (x : A) -> (y : A) -> Path A x y
def isPropPi : (A : Type 0) -> (B : A -> Type 0) -> ((a : A) -> isProp (B a)) -> isProp ((a : A) -> B a) :=
  fun A B h f g => <i> fun (a : A) => (h a (f a) (g a)) @ i
def isPropPathInSet : (A : Type 0) -> isSet A -> (x y : A) -> isProp (Path A x y) :=
  fun A s x y => s x y
def isPropTrunc : (A : Type 0) -> isProp (Trunc A) := fun A x y => truncSquash A x y
-- A line of propositions has a PathP between any two end points: transp each end point to i, then take the path of the proposition at i.
def isPropPathP : (B : I -> Type 0) -> ((i : I) -> isProp (B i)) -> (b0 : B i0) -> (b1 : B i1) -> PathP B b0 b1 :=
  fun B h b0 b1 => <i> (h i (transp (fun j => B (i /\ j)) (~ i) b0) (transp (fun j => B (i \/ ~ j)) i b1)) @ i
-- The types of the soundness and completeness fields of a layer, as functions of the circuit and the denotation.
def layerSoundT : (I : Inst) -> (a b : Shape) -> Circuit a b -> (instWeights I -> Tensor (instF I) a -> Tensor (instF I) b) -> Type 0 :=
  fun I a b c d => (x : Tensor (instF I) a) -> (w : instWitness I) -> instSat I a b c x w -> Path (Tensor (instF I) b) (d (instWeightsOf I w) x) (instEval I a b c w)
def layerCompleteT : (I : Inst) -> (a b : Shape) -> Circuit a b -> (instWeights I -> Tensor (instF I) a -> Tensor (instF I) b) -> Type 0 :=
  fun I a b c d => (ws : instWeights I) -> (x : Tensor (instF I) a) -> Trunc (layerWit I a b c d ws x)
-- Soundness is a proposition: a Pi into a path in a set (instTensorSet).
def layerSoundProp : (I : Inst) -> (a b : Shape) -> (c : Circuit a b) -> (d : instWeights I -> Tensor (instF I) a -> Tensor (instF I) b) -> isProp (layerSoundT I a b c d) :=
  fun I a b c d => isPropPi (Tensor (instF I) a) (fun x => (w : instWitness I) -> instSat I a b c x w -> Path (Tensor (instF I) b) (d (instWeightsOf I w) x) (instEval I a b c w))
    (fun x => isPropPi (instWitness I) (fun w => instSat I a b c x w -> Path (Tensor (instF I) b) (d (instWeightsOf I w) x) (instEval I a b c w))
      (fun w => isPropPi (instSat I a b c x w) (fun h => Path (Tensor (instF I) b) (d (instWeightsOf I w) x) (instEval I a b c w))
        (fun h => isPropPathInSet (Tensor (instF I) b) (instTensorSet I b) (d (instWeightsOf I w) x) (instEval I a b c w))))
-- Completeness is a proposition: a Pi into a Trunc (truncSquash).
def layerCompleteProp : (I : Inst) -> (a b : Shape) -> (c : Circuit a b) -> (d : instWeights I -> Tensor (instF I) a -> Tensor (instF I) b) -> isProp (layerCompleteT I a b c d) :=
  fun I a b c d => isPropPi (instWeights I) (fun ws => (x : Tensor (instF I) a) -> Trunc (layerWit I a b c d ws x))
    (fun ws => isPropPi (Tensor (instF I) a) (fun x => Trunc (layerWit I a b c d ws x)) (fun x => isPropTrunc (layerWit I a b c d ws x)))
-- Layer extensionality (D10): paths on the circuit, the denotation and the resources give a path in Layer.
-- The soundness and completeness paths come from isPropPathP.
def layerExt : (I : Inst) -> (a b : Shape) -> (L1 L2 : Layer I a b) -> (pc : Path (Circuit a b) (layerCircuit L1) (layerCircuit L2)) -> (pd : Path (instWeights I -> Tensor (instF I) a -> Tensor (instF I) b) (layerDen L1) (layerDen L2)) -> Path Resource (layerRes L1) (layerRes L2) -> Path (Layer I a b) L1 L2 :=
  fun I a b L1 L2 pc pd pr => <i> layer I a b (pc @ i) (pd @ i)
    ((isPropPathP (fun j => layerSoundT I a b (pc @ j) (pd @ j)) (fun j => layerSoundProp I a b (pc @ j) (pd @ j)) (layerSound L1) (layerSound L2)) @ i)
    ((isPropPathP (fun j => layerCompleteT I a b (pc @ j) (pd @ j)) (fun j => layerCompleteProp I a b (pc @ j) (pd @ j)) (layerComplete L1) (layerComplete L2)) @ i)
    (pr @ i)
-- The category laws on Layer (N2, D10). Each law is a layerExt proof, not refl. The circuit path is a Circuit
-- path constructor, the denotation path is refl and the resource path is a Resource law.
-- layerIdl: idL after L (design idL-unitl; circIdr, resUnitL).
def layerIdl : (I : Inst) -> (a b : Shape) -> (L : Layer I a b) -> Path (Layer I a b) (layerSeq I a b b (idL I b) L) L :=
  fun I a b L => layerExt I a b (layerSeq I a b b (idL I b) L) L (circIdr a b (layerCircuit L)) refl (resUnitL (layerRes L))
-- layerIdr: L after idL (design idL-unitr; circIdl, resUnitR).
def layerIdr : (I : Inst) -> (a b : Shape) -> (L : Layer I a b) -> Path (Layer I a b) (layerSeq I a a b L (idL I a)) L :=
  fun I a b L => layerExt I a b (layerSeq I a a b L (idL I a)) L (circIdl a b (layerCircuit L)) refl (resUnitR (layerRes L))
-- layerAssoc: the design order (L3 o L2) o L1 to L3 o (L2 o L1); the circuit path is symm of circAssoc.
def layerAssoc : (I : Inst) -> (a b c d : Shape) -> (L3 : Layer I c d) -> (L2 : Layer I b c) -> (L1 : Layer I a b) -> Path (Layer I a d) (layerSeq I a b d (layerSeq I b c d L3 L2) L1) (layerSeq I a c d L3 (layerSeq I a b c L2 L1)) :=
  fun I a b c d L3 L2 L1 => layerExt I a d (layerSeq I a b d (layerSeq I b c d L3 L2) L1) (layerSeq I a c d L3 (layerSeq I a b c L2 L1)) (symm (circAssoc a b c d (layerCircuit L1) (layerCircuit L2) (layerCircuit L3))) refl (resAssoc (layerRes L3) (layerRes L2) (layerRes L1))
-- The h-level library at the set level (slice Z5c, D11).
-- isSetPi: a function into sets is a set. The square is pointwise.
def isSetPi : (A : Type 0) -> (B : A -> Type 0) -> ((a : A) -> isSet (B a)) -> isSet ((a : A) -> B a) :=
  fun A B h f g p q => <i> <j> fun (x : A) => h x (f x) (g x) (<k> (p @ k) x) (<k> (q @ k) x) @ i @ j
-- isSetResource: natIsSet on each field, then record eta (D5).
def isSetResource : isSet Resource :=
  fun x y p q => <i> <j> res (natIsSet (resGates x) (resGates y) (<k> resGates (p @ k)) (<k> resGates (q @ k)) @ i @ j)
    (natIsSet (resLookups x) (resLookups y) (<k> resLookups (p @ k)) (<k> resLookups (q @ k)) @ i @ j)
    (natIsSet (resDegree x) (resDegree y) (<k> resDegree (p @ k)) (<k> resDegree (q @ k)) @ i @ j)
-- shapeSize s: the number of entries at the shape s (the product of the dims).
def shapeSize : Shape -> Nat := fun s => fold (fun (d : Nat) (acc : Nat) => natMul d acc) 1 (dims s)
-- shapeRows s: the number of rows of the last dim (the product of the other
-- dims). The inner motive fold splits on the tail: the last dim counts 1.
def shapeRows : Shape -> Nat := fun s => fold (fun (l : List Nat) => Nat) (fun (d : Nat) => fun (l : List Nat) => fun (r : Nat) => fold (fun (l2 : List Nat) => Nat) (fun (d2 : Nat) => fun (l2 : List Nat) => fun (r2 : Nat) => natMul d r) 1 l) 1 (dims s)
-- opRes: the resources of an operator, by an Op fold. opQuantize s k uses one
-- linear gate (x = q 2^k + r) and one range lookup (r < 2^k) for each entry.
-- opMatMul n m k uses one multiplication gate for each product: n m gates, degree 2.
-- opLookup uses one table lookup for each entry. opSoftmax uses 2 gates (m - x
-- and e 2^k = q sum + r) and 3 lookups (m - x, the table, r < sum) for each
-- entry, and 1 gate (the sum) for each row. opLayerNorm uses 4 gates (x - mean,
-- the square, c r, gamma c r + beta) for each entry, and 2 gates (the mean and
-- the variance divisions) and 3 lookups (2 remainders, the table) for each row.
-- opAttention h d uses 3 h d d gates for Q, K and V, h h d gates for the scores,
-- h h d gates for the output and the opSoftmax cost at h h entries and h rows.
def opRes : (a b : Shape) -> Op a b -> Resource :=
  fun a b o => fold (fun (a : Shape) => fun (b : Shape) => Resource) (fun qzS qzK => res (shapeSize qzS) (shapeSize qzS) 1) (fun mmN mmM mmK => res (natMul mmN mmM) 0 2) (fun lkS lkT => res 0 (shapeSize lkS) 1) (fun smS smT smK => res (natAdd (natMul 2 (shapeSize smS)) (shapeRows smS)) (natMul 3 (shapeSize smS)) 2) (fun lnS lnG lnT => res (natAdd (natMul 4 (shapeSize lnS)) (natMul 2 (shapeRows lnS))) (natMul 3 (shapeRows lnS)) 2) (fun atH atD atQ atK atV atT atE => res (natAdd (natMul 3 (natMul atH (natMul atD atD))) (natAdd (natMul 2 (natMul atH (natMul atH atD))) (natAdd (natMul 2 (natMul atH atH)) atH))) (natMul 3 (natMul atH atH)) 2) o
-- cost (N5): the resources of a circuit, by a Circuit fold. circId costs zeroR,
-- circSeq adds and circOp costs opRes. circResidual adds one linear gate for each
-- entry (the sum x + f x). The path cases are the Resource laws and isSetResource.
def cost : (a b : Shape) -> Circuit a b -> Resource :=
  fun a b x => fold (fun (a : Shape) => fun (b : Shape) => Resource) (fun idA => zeroR) (fun seqA seqB seqC seqF seqG => resAdd seqF seqG) (fun opA opB opO => opRes opA opB opO) (fun rsS rsF => resAdd rsF (res (shapeSize rsS) 0 1)) (fun idlA idlB idlF => refl) (fun idrA idrB idrF => refl) (fun asA asB asC asD asF asG asH => resAssoc asF asG asH) (fun sqA sqB sqF sqG sqP sqQ => isSetResource sqF sqG sqP sqQ) x
-- circResidualLoop s f n (N6): n residual steps of f after circId, by Nat induction.
def circResidualLoop : (s : Shape) -> Circuit s s -> Nat -> Circuit s s :=
  fun s f n => fold (fun (k : Nat) => Circuit s s) (fun (k : Nat) (acc : Circuit s s) => circSeq s s s acc (circResidual s f)) (circId s) n
-- resScale n r: n copies of r under resAdd, by Nat induction (resScale 0 r is zeroR).
def resScale : Nat -> Resource -> Resource := fun n r => fold (fun (k : Nat) => Resource) (fun (k : Nat) (acc : Resource) => resAdd acc r) zeroR n
-- costResidualLoop: the cost of n residual steps is n times the cost of one step.
-- The proof is a Nat induction. Each step is cong of resAdd.
def costResidualLoop : (s : Shape) -> (f : Circuit s s) -> (n : Nat) -> Path Resource (cost s s (circResidualLoop s f n)) (resScale n (cost s s (circResidual s f))) :=
  fun s f n => fold (fun (k : Nat) => Path Resource (cost s s (circResidualLoop s f k)) (resScale k (cost s s (circResidual s f)))) (fun (k : Nat) (ih : Path Resource (cost s s (circResidualLoop s f k)) (resScale k (cost s s (circResidual s f)))) => cong (fun (r : Resource) => resAdd r (cost s s (circResidual s f))) ih) refl n
-- costLayer: a layer with the cost of its circuit as its resources. layerRes
-- stays a free field of Layer (N5), so costLayer is a smart constructor.
def costLayer : (I : Inst) -> (a b : Shape) -> (f : Circuit a b) -> (den : instWeights I -> Tensor (instF I) a -> Tensor (instF I) b) -> (snd : (x : Tensor (instF I) a) -> (w : instWitness I) -> instSat I a b f x w -> Path (Tensor (instF I) b) (den (instWeightsOf I w) x) (instEval I a b f w)) -> (cpl : (ws : instWeights I) -> (x : Tensor (instF I) a) -> Trunc (layerWit I a b f den ws x)) -> Layer I a b :=
  fun I a b f den snd cpl => layer I a b f den snd cpl (cost a b f)
def costLayerRes : (I : Inst) -> (a b : Shape) -> (f : Circuit a b) -> (den : instWeights I -> Tensor (instF I) a -> Tensor (instF I) b) -> (snd : (x : Tensor (instF I) a) -> (w : instWitness I) -> instSat I a b f x w -> Path (Tensor (instF I) b) (den (instWeightsOf I w) x) (instEval I a b f w)) -> (cpl : (ws : instWeights I) -> (x : Tensor (instF I) a) -> Trunc (layerWit I a b f den ws x)) -> Path Resource (layerRes (costLayer I a b f den snd cpl)) (cost a b f) :=
  fun I a b f den snd cpl => refl
-- isPropIsSet: a proposition is a set. The square is an hcomp of the paths h x _ from x.
def isPropIsSet : (A : Type 0) -> isProp A -> isSet A :=
  fun A h x y p q => <j> <i> hcomp (fun k => [ ~ i |-> h x x @ k , i |-> h x y @ k , ~ j |-> h x (p @ i) @ k , j |-> h x (q @ i) @ k ]) x
-- The List h-level library (slice Z6, part Z6c). The kit has no Empty type,
-- and Unit has no eta and no eliminator (flag 18). Void is Path Nat 0 1. It is
-- a proposition by natIsSet. voidElim gives each type from it: a transp over a
-- Nat motive fold into Type 0.
def isPropProd : (P Q : Type 0) -> isProp P -> isProp Q -> isProp (Prod P Q) :=
  fun P Q hp hq a b => <i> pair (hp (first a) (first b) @ i) (hq (second a) (second b) @ i)
def Void : Type 0 := Path Nat 0 1
def isPropVoid : isProp Void := isPropPathInSet Nat natIsSet 0 1
def voidElim : (T : Type 0) -> Void -> T :=
  fun T c => transp (fun i => fold (fun (k : Nat) => Type 0) (fun (k : Nat) => fun (acc : Type 0) => T) Unit (c @ i)) i0 unit
-- isSetList by encode-decode. The code of nil and nil is Path Nat 0 0. The code
-- of two cons cells is a Path of the heads and the code of the tails. The code
-- of nil and a cons cell is Void.
def listCode : (A : Type 0) -> List A -> List A -> Type 0 :=
  fun A xs => fold (fun (x : A) (acc : List A -> Type 0) => fun (ys : List A) => fold (fun (m : List A) => Type 0) (fun (y : A) => fun (u : List A) => fun (r : Type 0) => Prod (Path A x y) (acc u)) Void ys)
    (fun (ys : List A) => fold (fun (m : List A) => Type 0) (fun (y : A) => fun (u : List A) => fun (r : Type 0) => Void) (Path Nat 0 0) ys) xs
def listCodeRefl : (A : Type 0) -> (xs : List A) -> listCode A xs xs :=
  fun A xs => fold (fun (l : List A) => listCode A l l) (fun (h : A) => fun (t : List A) => fun (ih : listCode A t t) => pair refl ih) refl xs
-- listEncode: transp of the reflexive code along the line of the codes from xs to p @ i.
def listEncode : (A : Type 0) -> (xs ys : List A) -> Path (List A) xs ys -> listCode A xs ys :=
  fun A xs ys p => transp (fun i => listCode A xs (p @ i)) i0 (listCodeRefl A xs)
-- listDecode: a List motive fold on xs, then a List motive fold on ys.
def listDecode : (A : Type 0) -> (xs ys : List A) -> listCode A xs ys -> Path (List A) xs ys :=
  fun A xs => fold (fun (l : List A) => (ys : List A) -> listCode A l ys -> Path (List A) l ys)
    (fun (x : A) => fun (t : List A) => fun (ih : (ys : List A) -> listCode A t ys -> Path (List A) t ys) => fun (ys : List A) =>
      fold (fun (m : List A) => listCode A (cons x t) m -> Path (List A) (cons x t) m)
        (fun (y : A) => fun (u : List A) => fun (r : listCode A (cons x t) u -> Path (List A) (cons x t) u) => fun (c : listCode A (cons x t) (cons y u)) => <i> cons ((first c) @ i) ((ih u (second c)) @ i))
        (fun (c : listCode A (cons x t) nil) => voidElim (Path (List A) (cons x t) nil) c) ys)
    (fun (ys : List A) => fold (fun (m : List A) => listCode A nil m -> Path (List A) nil m)
        (fun (y : A) => fun (u : List A) => fun (r : listCode A nil u -> Path (List A) nil u) => fun (c : listCode A nil (cons y u)) => voidElim (Path (List A) nil (cons y u)) c)
        (fun (c : listCode A nil nil) => refl) ys) xs
def listDecodeRefl : (A : Type 0) -> (xs : List A) -> Path (Path (List A) xs xs) (listDecode A xs xs (listCodeRefl A xs)) refl :=
  fun A xs => fold (fun (l : List A) => Path (Path (List A) l l) (listDecode A l l (listCodeRefl A l)) refl)
    (fun (x : A) => fun (t : List A) => fun (ih : Path (Path (List A) t t) (listDecode A t t (listCodeRefl A t)) refl) => <j> <i> cons x ((ih @ j) @ i))
    refl xs
-- listDecodeEncode: transp of listDecodeRefl along i. At i the path is from
-- xs to p @ i, and the code is the transp of the reflexive code to p @ i.
def listDecodeEncode : (A : Type 0) -> (xs ys : List A) -> (p : Path (List A) xs ys) -> Path (Path (List A) xs ys) (listDecode A xs ys (listEncode A xs ys p)) p :=
  fun A xs ys p => transp (fun i => Path (Path (List A) xs (p @ i)) (listDecode A xs (p @ i) (transp (fun k => listCode A xs (p @ (i /\ k))) (~ i) (listCodeRefl A xs))) (<j> p @ (i /\ j))) i0 (listDecodeRefl A xs)
def isPropListCode : (A : Type 0) -> isSet A -> (xs ys : List A) -> isProp (listCode A xs ys) :=
  fun A sA xs => fold (fun (l : List A) => (ys : List A) -> isProp (listCode A l ys))
    (fun (x : A) => fun (t : List A) => fun (ih : (ys : List A) -> isProp (listCode A t ys)) => fun (ys : List A) =>
      fold (fun (m : List A) => isProp (listCode A (cons x t) m))
        (fun (y : A) => fun (u : List A) => fun (r : isProp (listCode A (cons x t) u)) => isPropProd (Path A x y) (listCode A t u) (isPropPathInSet A sA x y) (ih u))
        isPropVoid ys)
    (fun (ys : List A) => fold (fun (m : List A) => isProp (listCode A nil m))
        (fun (y : A) => fun (u : List A) => fun (r : isProp (listCode A nil u)) => isPropVoid)
        (isPropPathInSet Nat natIsSet 0 0) ys) xs
-- isSetList: p is the decode of its code, the codes of p and q are equal, and q is the decode of its code.
def isSetList : (A : Type 0) -> isSet A -> isSet (List A) :=
  fun A sA xs ys p q => trans (symm (listDecodeEncode A xs ys p)) (trans (cong (listDecode A xs ys) (isPropListCode A sA xs ys (listEncode A xs ys p) (listEncode A xs ys q))) (listDecodeEncode A xs ys q))
-- isSetTensor: isSetList at each dimension, by a List motive fold over dims s.
-- A concrete Inst gets instTensorSet from it (part Z6d).
def isSetTensor : (F : Type 0) -> isSet F -> (s : Shape) -> isSet (Tensor F s) :=
  fun F sF s => fold (fun (l : List Nat) => isSet (fold (fun (d : Nat) (T : Type 0) => List T) F l)) (fun (d : Nat) => fun (l : List Nat) => fun (ih : isSet (fold (fun (d : Nat) (T : Type 0) => List T) F l)) => isSetList (fold (fun (d : Nat) (T : Type 0) => List T) F l) ih) sF (dims s)
-- The tensor library (part Z6c). TensorL A l is the Tensor at the list of
-- dimensions l, so Tensor A s is TensorL A (dims s). Each operation is a List
-- motive fold over the dimensions.
def TensorL : Type 0 -> List Nat -> Type 0 := fun (A : Type 0) (l : List Nat) => fold (fun (d : Nat) (T : Type 0) => List T) A l
-- listRep A n a: the list of n copies of a (a Nat motive fold).
def listRep : (A : Type 0) -> Nat -> A -> List A :=
  fun A n a => fold (fun (k : Nat) => List A) (fun (k : Nat) => fun (acc : List A) => cons a acc) nil n
-- zeroT A z s: the tensor at the shape s with z at each entry. Each dimension d
-- repeats the lower tensor d times.
def zeroT : (A : Type 0) -> A -> (s : Shape) -> Tensor A s :=
  fun A z s => fold (fun (l : List Nat) => TensorL A l) (fun (d : Nat) => fun (l : List Nat) => fun (ih : TensorL A l) => listRep (TensorL A l) d ih) z (dims s)
-- mapT: f at each entry. Each dimension is a List map.
def mapT : (A B : Type 0) -> (A -> B) -> (s : Shape) -> Tensor A s -> Tensor B s :=
  fun A B f s => fold (fun (l : List Nat) => TensorL A l -> TensorL B l) (fun (d : Nat) => fun (l : List Nat) => fun (ih : TensorL A l -> TensorL B l) => fun (x : List (TensorL A l)) => map ih x) f (dims s)
-- listUncons: the head and tail of a nonempty list.
def listUncons : (A : Type 0) -> List A -> Option (Prod A (List A)) :=
  fun A xs => fold (fun (l : List A) => Option (Prod A (List A))) (fun (x : A) => fun (t : List A) => fun (r : Option (Prod A (List A))) => some (pair x t)) none xs
-- listZipWith: unfold the two tails, bounded by the length of xs. The state
-- contains list data, so a runtime list does not require a function value.
-- It stops at the end of the shorter list.
def listZipWith : (A B C : Type 0) -> (A -> B -> C) -> List A -> List B -> List C :=
  fun A B C f xs ys => unfold
    (fun (st : Prod (List A) (List B)) => bind (listUncons A (first st)) (fun (a : Prod A (List A)) => map (fun (b : Prod B (List B)) => pair (f (first a) (first b)) (pair (second a) (second b))) (listUncons B (second st))))
    (fold (fun (x : A) (n : Nat) => natAdd n 1) 0 xs) (pair xs ys)
-- zipWithT: listZipWith at each dimension.
def zipWithT : (A B C : Type 0) -> (A -> B -> C) -> (s : Shape) -> Tensor A s -> Tensor B s -> Tensor C s :=
  fun A B C f s => fold (fun (l : List Nat) => TensorL A l -> TensorL B l -> TensorL C l) (fun (d : Nat) => fun (l : List Nat) => fun (ih : TensorL A l -> TensorL B l -> TensorL C l) => listZipWith (TensorL A l) (TensorL B l) (TensorL C l) ih) f (dims s)
-- sumT: the sum of the entries with add and its zero. An instance gives add (part Z6d).
def sumT : (A : Type 0) -> (A -> A -> A) -> A -> (s : Shape) -> Tensor A s -> A :=
  fun A add z s => fold (fun (l : List Nat) => TensorL A l -> A) (fun (d : Nat) => fun (l : List Nat) => fun (ih : TensorL A l -> A) => fun (x : List (TensorL A l)) => fold (fun (t : TensorL A l) (acc : A) => add (ih t) acc) z x) (fun (a : A) => a) (dims s)
-- A stage of a trace: a shape and a tensor at that shape. stageEnc is pack.
def Stage : Type 0 -> Type 0 := fun (A : Type 0) => Sigma (s : Shape) (Tensor A s)
def stageEnc : (A : Type 0) -> (s : Shape) -> Tensor A s -> Stage A := fun A s x => pack s x
-- listView records the empty or nonempty case with an equality for transport.
-- Its fold returns data, so the case split also lowers for a runtime list.
def listView : (A : Type 0) -> (xs : List A) -> Sum (Eq (List A) xs nil) (Sigma (h : A) (Sigma (t : List A) (Eq (List A) xs (cons h t)))) :=
  fun A xs => fold (fun (l : List A) => Sum (Eq (List A) l nil) (Sigma (h : A) (Sigma (t : List A) (Eq (List A) l (cons h t)))))
    (fun (h : A) => fun (t : List A) => fun ih => inr (pack h (pack t refl))) (inl refl) xs
-- tensorConv A z l m: read a tensor at the dimensions m as a tensor at the
-- dimensions l. Each level of l reads one level of m. When m has more levels,
-- the result at a scalar is z. When m has fewer levels, the result at a list level is nil.
def tensorConv : (A : Type 0) -> A -> (l m : List Nat) -> TensorL A m -> TensorL A l :=
  fun A z l => fold (fun (l1 : List Nat) => (m : List Nat) -> TensorL A m -> TensorL A l1)
    (fun (d : Nat) => fun (l1 : List Nat) => fun (ih : (m : List Nat) -> TensorL A m -> TensorL A l1) => fun (m : List Nat) => fun (x : TensorL A m) =>
      either (fun (p : Eq (List Nat) m nil) => nil)
        (fun (v : Sigma (e : Nat) (Sigma (m1 : List Nat) (Eq (List Nat) m (cons e m1)))) => map (ih (witness (payload v))) (transport (fun (ds : List Nat) => TensorL A ds) (payload (payload v)) x))
        (listView Nat m))
    (fun (m : List Nat) => fun (x : TensorL A m) =>
      either (fun (p : Eq (List Nat) m nil) => transport (fun (ds : List Nat) => TensorL A ds) p x)
        (fun (v : Sigma (e : Nat) (Sigma (m1 : List Nat) (Eq (List Nat) m (cons e m1)))) => z)
        (listView Nat m)) l
-- stageDec A z s: read a stage at the shape s.
def stageDec : (A : Type 0) -> A -> (s : Shape) -> Stage A -> Tensor A s :=
  fun A z s st => tensorConv A z (dims s) (dims (witness st)) (payload st)
-- tensorConvSame: tensorConv at the same dimensions is the identity. A List
-- motive fold over the dimensions, then a List motive fold over the entries.
def tensorConvSame : (A : Type 0) -> (z : A) -> (l : List Nat) -> (x : TensorL A l) -> Path (TensorL A l) (tensorConv A z l l x) x :=
  fun A z l => fold (fun (l1 : List Nat) => (x : TensorL A l1) -> Path (TensorL A l1) (tensorConv A z l1 l1 x) x)
    (fun (d : Nat) => fun (l1 : List Nat) => fun (ih : (x : TensorL A l1) -> Path (TensorL A l1) (tensorConv A z l1 l1 x) x) => fun (x : List (TensorL A l1)) =>
      fold (fun (ys : List (TensorL A l1)) => Path (List (TensorL A l1)) (map (tensorConv A z l1 l1) ys) ys)
        (fun (h : TensorL A l1) => fun (t : List (TensorL A l1)) => fun (r : Path (List (TensorL A l1)) (map (tensorConv A z l1 l1) t) t) => <i> cons (ih h @ i) (r @ i))
        refl x)
    (fun (x : A) => refl) l
-- stageDecEnc: the round trip. stageDec at the shape of the stage gives the tensor back.
def stageDecEnc : (A : Type 0) -> (z : A) -> (s : Shape) -> (x : Tensor A s) -> Path (Tensor A s) (stageDec A z s (stageEnc A s x)) x :=
  fun A z s x => tensorConvSame A z (dims s) x
-- stageLast: the last stage of a trace, or none for the empty trace.
def stageLast : (A : Type 0) -> List (Stage A) -> Option (Stage A) :=
  fun A xs => fold (fun (h : Stage A) (r : Option (Stage A)) => option (some h) (fun (t : Stage A) => some t) r) none xs
-- BabyBear (Z6d): p = 2^31 - 2^27 + 1. A field value is a Nat below p. The
-- product of two values is below 2^62, so natMul does not trap. bbSub
-- reduces b first, so a + p - b does not truncate at 0.
def bbP : Nat := 2013265921
def bbAdd : Nat -> Nat -> Nat := fun a b => natMod (natAdd a b) bbP
def bbSub : Nat -> Nat -> Nat := fun a b => natMod (natSub (natAdd a bbP) (natMod b bbP)) bbP
def bbMul : Nat -> Nat -> Nat := fun a b => natMod (natMul a b) bbP
def bbNeg : Nat -> Nat := fun a => bbSub 0 a
-- The BabyBear Inst fields. The weights type W is an argument (one record
-- per model). A witness is the weights and a trace of stages.
def bbInstTensorSet : (s : Shape) -> isSet (Tensor Nat s) := fun s => isSetTensor Nat natIsSet s
def bbInstInputWit : (W : Type 0) -> (s : Shape) -> W -> Tensor Nat s -> Prod W (List (Stage Nat)) :=
  fun W s ws x => pair ws (cons (stageEnc Nat s x) nil)
-- bbInstEval reads the last stage at the shape b. The empty trace gives zeroT.
def bbInstEval : (W : Type 0) -> (a b : Shape) -> Circuit a b -> Prod W (List (Stage Nat)) -> Tensor Nat b :=
  fun W a b f w => option (zeroT Nat 0 b) (fun (st : Stage Nat) => stageDec Nat 0 b st) (stageLast Nat (second w))
-- bbInstInputEval: the input witness has one stage, so the read is the round trip.
def bbInstInputEval : (W : Type 0) -> (s : Shape) -> (ws : W) -> (x : Tensor Nat s) -> Path (Tensor Nat s) (bbInstEval W s s (circId s) (bbInstInputWit W s ws x)) x :=
  fun W s ws x => stageDecEnc Nat 0 s x
-- pow2 k: 2 to the power k, by Nat induction. Exponents >= 64 overflow Nat.
def pow2 : Nat -> Nat := fun k => fold (fun (n : Nat) => Nat) (fun (n : Nat) (acc : Nat) => natMul acc 2) 1 k
-- BbWeights: the weights of bbRun, a list of matrices. A matrix is a list of rows.
def BbWeights : Type 0 := List (List (List Nat))
-- listAt A d k xs: the entry k of xs, or d when xs is too short. The Nat fold
-- drops k entries and the List fold takes the head. Both folds give data.
def listAt : (A : Type 0) -> A -> Nat -> List A -> A :=
  fun A d k xs => fold (fun (h : A) (acc : A) => h) d (fold (fun (n : Nat) => List A) (fun (n : Nat) (r : List A) => fold (fun (l : List A) => List A) (fun (h : A) => fun (t : List A) => fun (rt : List A) => t) nil r) xs k)
-- bbDot: the BabyBear dot product of two lists. It stops at the shorter list.
def bbDot : List Nat -> List Nat -> Nat := fun r x => fold (fun (h : Nat) (acc : Nat) => bbAdd h acc) 0 (listZipWith Nat Nat Nat bbMul r x)
-- bbMatVec: one dot product for each row of the matrix.
def bbMatVec : List (List Nat) -> List Nat -> List Nat := fun mt x => map (fun (r : List Nat) => bbDot r x) mt
-- mapLastT A B z g s: the row function g on each row of the last dim. The step
-- of the dims fold splits on the tail by a second motive fold: the last dim
-- takes g, each other dim takes a List map. At rank 0 the entry is a row of
-- length 1 and the result is the head of g (z when g gives nil).
def mapLastT : (A B : Type 0) -> B -> (List A -> List B) -> (s : Shape) -> Tensor A s -> Tensor B s :=
  fun A B z g s => fold (fun (l : List Nat) => TensorL A l -> TensorL B l) (fun (d : Nat) => fun (l : List Nat) => fun (ih : TensorL A l -> TensorL B l) => (fold (fun (l2 : List Nat) => (TensorL A l2 -> TensorL B l2) -> List (TensorL A l2) -> List (TensorL B l2)) (fun (d2 : Nat) => fun (l2 : List Nat) => fun (r2 : (TensorL A l2 -> TensorL B l2) -> List (TensorL A l2) -> List (TensorL B l2)) => fun (f2 : TensorL A (cons d2 l2) -> TensorL B (cons d2 l2)) => fun (x2 : List (TensorL A (cons d2 l2))) => map f2 x2) (fun (f0 : A -> B) => g) l) ih) (fun (a : A) => listAt B z 0 (g (cons a nil))) (dims s)
-- listLen, listSumNat, listMaxNat: the length, the Nat sum and the Nat max.
def listLen : (A : Type 0) -> List A -> Nat := fun A xs => fold (fun (h : A) (acc : Nat) => natAdd acc 1) 0 xs
def listSumNat : List Nat -> Nat := fun xs => fold (fun (h : Nat) (acc : Nat) => natAdd h acc) 0 xs
def listMaxNat : List Nat -> Nat := fun xs => fold (fun (h : Nat) (acc : Nat) => natMax h acc) 0 xs
-- bbTableRow reads a key and value, ignoring rows with fewer than two entries.
def bbTableRow : List Nat -> Option (Prod Nat Nat) :=
  fun r => fold (fun (l : List Nat) => Option (Prod Nat Nat)) (fun (h : Nat) => fun (t : List Nat) => fun (ih : Option (Prod Nat Nat)) => fold (fun (e : Nat) (acc : Option (Prod Nat Nat)) => some (pair h e)) none t) none r
-- bbLookup tb d v: the value of the first row [v, e] of the table tb, or d when
-- no complete row has the key v. The fold gives data (flagIf on natEq).
def bbLookup : List (List Nat) -> Nat -> Nat -> Nat :=
  fun tb d v => fold (fun (r : List Nat) (acc : Nat) => option acc (fun (kv : Prod Nat Nat) => flagIf (natEq (first kv) v) (second kv) acc) (bbTableRow r)) d tb
-- bbTableHit tb v: 1 when a row of tb has the key v, else 0. bbTableMem tb v:
-- the membership of v in tb, a proposition (a path in Nat, flag 18 (i)).
-- bbTableIn tb: the keys of tb with a membership proof. A lookup is complete
-- only for these inputs (flag 18).
def bbTableHit : List (List Nat) -> Nat -> Nat :=
  fun tb v => fold (fun (r : List Nat) (acc : Nat) => option acc (fun (kv : Prod Nat Nat) => flagIf (natEq (first kv) v) 1 acc) (bbTableRow r)) 0 tb
def bbTableMem : List (List Nat) -> Nat -> Type 0 := fun tb v => Path Nat (bbTableHit tb v) 1
def bbTableIn : List (List Nat) -> Type 0 := fun tb => Sigma (v : Nat) (bbTableMem tb v)
-- bbSoftmaxRow tb k x: m is the max of the row, e is tb at m - x for each entry
-- (natSub, so the key is not negative), and q = floor(e 2^k / sum e). A sum of
-- 0 reads as 1 (as in the Wasm writer), so q is 0 and there is no trap.
-- Double a quotient and remainder without forming 2 r when it would overflow.
-- For positive t, each step preserves q t + r = v 2^n and r < t. Only an
-- unrepresentable quotient overflows; the intermediate product is never built.
def bbSoftmaxDouble : Nat -> Prod Nat Nat -> Prod Nat Nat :=
  fun t qr => pair (natAdd (natMul 2 (first qr)) (flagIf (natLe (natSub t (second qr)) (second qr)) 1 0)) (natAdd (natSub (second qr) (natSub t (second qr))) (natMul 2 (flagIf (natLe (natSub t (second qr)) (second qr)) 0 (second qr))))
def bbSoftmaxScale : Nat -> Nat -> Nat -> Nat :=
  fun k t v => first (fold (fun (n : Nat) => Prod Nat Nat) (fun (n : Nat) (qr : Prod Nat Nat) => bbSoftmaxDouble t qr) (pair (natDiv v t) (natMod v t)) k)
def bbSoftmaxDiv : Nat -> Nat -> List Nat -> List Nat := fun k t e => map (fun (v : Nat) => bbSoftmaxScale k (natMax t 1) v) e
def bbSoftmaxExp : List (List Nat) -> Nat -> List Nat -> List Nat := fun tb m x => map (fun (v : Nat) => bbLookup tb 0 (natSub m v)) x
def bbSoftmaxNorm : Nat -> List Nat -> List Nat := fun k e => bbSoftmaxDiv k (listSumNat e) e
def bbSoftmaxRow : List (List Nat) -> Nat -> List Nat -> List Nat := fun tb k x => bbSoftmaxNorm k (bbSoftmaxExp tb (listMaxNat x) x)
-- bbLayerNormRow gb tb x: the mean of the row (natDiv), the centered entries
-- c = x - mean in the field (bbSub), the variance (natDiv of the field sum of
-- c^2), r = tb at the variance (the inverse square root table) and
-- gamma c r + beta. gamma and beta are the rows 0 and 1 of gb. A length of 0
-- reads as 1.
def bbLnMean : List Nat -> Nat := fun x => natDiv (listSumNat x) (natMax (listLen Nat x) 1)
def bbLnCenter : Nat -> List Nat -> List Nat := fun mu x => map (fun (v : Nat) => bbSub v mu) x
def bbLnVar : List Nat -> Nat := fun c => natDiv (fold (fun (h : Nat) (acc : Nat) => bbAdd (bbMul h h) acc) 0 c) (natMax (listLen Nat c) 1)
def bbLnAffine : List (List Nat) -> Nat -> List Nat -> List Nat :=
  fun gb r c => listZipWith Nat Nat Nat bbAdd (listZipWith Nat Nat Nat bbMul (map (fun (v : Nat) => bbMul v r) c) (listAt (List Nat) nil 0 gb)) (listAt (List Nat) nil 1 gb)
def bbLnScaled : List (List Nat) -> List (List Nat) -> List Nat -> List Nat := fun gb tb c => bbLnAffine gb (bbLookup tb 0 (bbLnVar c)) c
def bbLayerNormRow : List (List Nat) -> List (List Nat) -> List Nat -> List Nat := fun gb tb x => bbLnScaled gb tb (bbLnCenter (bbLnMean x) x)
-- Attention (Z6g, O5): one head on the rows of x : [h, d]. Q, K and V are the
-- rows of x times W_Q, W_K and W_V (bbMatVec). bbAttnShift is (p - 1) / 2. Each
-- score gets it before the softmax, so the Nat order of the shifted scores is
-- the signed order of the scores in [-(p - 1) / 2, (p - 1) / 2] (flag 33).
-- bbAttnMix a vs d: the sum of a_j V_j over the rows of V, from a zero row of
-- length d. Reduce each scaled coefficient into the field before multiplying:
-- the softmax can return a Nat above p even when the field product fits.
-- bbAttnRow tb k d ks vs q: the softmax of the shifted scores K_j . q,
-- then the mix. The output keeps the 2^k scale of the softmax (flag 34).
def bbAttnShift : Nat := natDiv bbP 2
def bbAttnMix : List Nat -> List (List Nat) -> Nat -> List Nat :=
  fun a vs d => fold (fun (av : Prod Nat (List Nat)) (acc : List Nat) => listZipWith Nat Nat Nat bbAdd (map (fun (v : Nat) => bbMul (natMod (first av) bbP) v) (second av)) acc) (listRep Nat d 0) (listZipWith Nat (List Nat) (Prod Nat (List Nat)) (fun (u : Nat) (r : List Nat) => pair u r) a vs)
def bbAttnRow : List (List Nat) -> Nat -> Nat -> List (List Nat) -> List (List Nat) -> List Nat -> List Nat :=
  fun tb k d ks vs q => bbAttnMix (bbSoftmaxRow tb k (map (fun (s : Nat) => bbAdd s bbAttnShift) (bbMatVec ks q))) vs d
def bbAttention : List (List Nat) -> List (List Nat) -> List (List Nat) -> List (List Nat) -> Nat -> Nat -> List (List Nat) -> List (List Nat) :=
  fun wq wk wv tb k d x => map (fun (q : List Nat) => bbAttnRow tb k d (map (fun (r : List Nat) => bbMatVec wk r) x) (map (fun (r : List Nat) => bbMatVec wv r) x) q) (map (fun (r : List Nat) => bbMatVec wq r) x)
-- bbOpRun: the function of an operator at the weights ws, by an Op fold.
-- opQuantize s k divides each entry by 2^k and removes the remainder. Halve at
-- most 64 times, since every Nat is below 2^64. This avoids constructing an
-- overflowing divisor.
-- opMatMul n m k multiplies x by the matrix k of ws (nil when k is out of range).
-- opLookup s t reads the table t of ws (rows [key, value]) and gives 0 for a
-- missing key. opSoftmax s t k reads the exp table t of ws. opLayerNorm s g t
-- reads gamma and beta from the matrix g of ws and the table t of ws.
-- opAttention h d q k v t e reads W_Q, W_K, W_V (the matrices q, k, v of ws) and
-- the exp table t of ws; e is the k of the softmax.
def bbOpRun : (a b : Shape) -> Op a b -> BbWeights -> Tensor Nat a -> Tensor Nat b :=
  fun a b o => fold (fun (a : Shape) => fun (b : Shape) => BbWeights -> Tensor Nat a -> Tensor Nat b)
    (fun qzS qzK => fun (ws : BbWeights) => mapT Nat Nat (fun (v : Nat) => fold (fun (n : Nat) => Nat) (fun (n : Nat) (acc : Nat) => natDiv acc 2) v (natSub qzK (natSub qzK 64))) qzS)
    (fun mmN mmM mmK => fun (ws : BbWeights) => bbMatVec (listAt (List (List Nat)) nil mmK ws))
    (fun lkS lkT => fun (ws : BbWeights) => mapT Nat Nat (fun (v : Nat) => bbLookup (listAt (List (List Nat)) nil lkT ws) 0 v) lkS)
    (fun smS smT smK => fun (ws : BbWeights) => mapLastT Nat Nat 0 (bbSoftmaxRow (listAt (List (List Nat)) nil smT ws) smK) smS)
    (fun lnS lnG lnT => fun (ws : BbWeights) => mapLastT Nat Nat 0 (bbLayerNormRow (listAt (List (List Nat)) nil lnG ws) (listAt (List (List Nat)) nil lnT ws)) lnS)
    (fun atH atD atQ atK atV atT atE => fun (ws : BbWeights) => bbAttention (listAt (List (List Nat)) nil atQ ws) (listAt (List (List Nat)) nil atK ws) (listAt (List (List Nat)) nil atV ws) (listAt (List (List Nat)) nil atT ws) atE atD) o
-- bbRun: the function of a circuit, by a Circuit fold into the functions from
-- Tensor Nat a to Tensor Nat b. The laws hold by refl. The squash case is
-- isSetPi with bbInstTensorSet, because these functions are a set. circOp runs
-- bbOpRun. circResidual adds x to the result of the inner circuit (bbAdd).
-- Each operator gets the weights ws, so opMatMul reads its matrix from ws.
def bbRun : (a b : Shape) -> Circuit a b -> BbWeights -> Tensor Nat a -> Tensor Nat b :=
  fun a b f => fold (fun (a : Shape) => fun (b : Shape) => BbWeights -> Tensor Nat a -> Tensor Nat b)
    (fun idA => fun (ws : BbWeights) => fun (x : Tensor Nat idA) => x)
    (fun seqA seqB seqC seqF seqG => fun (ws : BbWeights) => fun (x : Tensor Nat seqA) => seqG ws (seqF ws x))
    (fun opA opB opO => bbOpRun opA opB opO)
    (fun rsS rsF => fun (ws : BbWeights) => fun (x : Tensor Nat rsS) => zipWithT Nat Nat Nat bbAdd rsS x (rsF ws x))
    (fun idlA idlB idlF => <i> idlF)
    (fun idrA idrB idrF => <i> idrF)
    (fun asA asB asC asD asF asG asH => <i> fun (ws : BbWeights) => fun (x : Tensor Nat asA) => asH ws (asG ws (asF ws x)))
    (fun sqA sqB sqF sqG sqP sqQ => isSetPi BbWeights (fun (v : BbWeights) => Tensor Nat sqA -> Tensor Nat sqB) (fun (v : BbWeights) => isSetPi (Tensor Nat sqA) (fun (y : Tensor Nat sqA) => Tensor Nat sqB) (fun (y : Tensor Nat sqA) => bbInstTensorSet sqB)) sqF sqG sqP sqQ) f
-- bbInstSat: a witness satisfies f at x when its last stage gives the result of
-- bbRun at the weights of w. rd reads the matrices from the weights type W.
-- It is a path in a set, not a Type-valued fold over Circuit.
def bbInstSat : (W : Type 0) -> (W -> BbWeights) -> (a b : Shape) -> Circuit a b -> Tensor Nat a -> Prod W (List (Stage Nat)) -> Type 0 :=
  fun W rd a b f x w => Path (Tensor Nat b) (bbRun a b f (rd (first w)) x) (bbInstEval W a b f w)
def bbInstWeightsOf : (W : Type 0) -> Prod W (List (Stage Nat)) -> W := fun W w => first w
def bbInstInputWeights : (W : Type 0) -> (s : Shape) -> (ws : W) -> (x : Tensor Nat s) -> Path W (bbInstWeightsOf W (bbInstInputWit W s ws x)) ws := fun W s ws x => refl
-- The input witness satisfies circId by the round trip of its stage.
def bbInstInputSat : (W : Type 0) -> (rd : W -> BbWeights) -> (s : Shape) -> (ws : W) -> (x : Tensor Nat s) -> bbInstSat W rd s s (circId s) x (bbInstInputWit W s ws x) := fun W rd s ws x => symm (bbInstInputEval W s ws x)
def bbInstIdSound : (W : Type 0) -> (rd : W -> BbWeights) -> (s : Shape) -> (x : Tensor Nat s) -> (w : Prod W (List (Stage Nat))) -> bbInstSat W rd s s (circId s) x w -> Path (Tensor Nat s) x (bbInstEval W s s (circId s) w) := fun W rd s x w h => h
-- bbInstSeqWit keeps the weights of u and the trace of v. An append of the
-- traces does not give bbInstSeqWitEval when v has no stages. It also does not
-- give bbInstSeqSat, because bbInstSat constrains only the last stage of w.
def bbInstSeqWit : (W : Type 0) -> (a b c : Shape) -> Circuit a b -> Circuit b c -> Prod W (List (Stage Nat)) -> Prod W (List (Stage Nat)) -> Prod W (List (Stage Nat)) :=
  fun W a b c f g u v => pair (first u) (second v)
def bbInstSeqWitWeights : (W : Type 0) -> (a b c : Shape) -> (f : Circuit a b) -> (g : Circuit b c) -> (u v : Prod W (List (Stage Nat))) -> Path W (bbInstWeightsOf W u) (bbInstWeightsOf W v) -> Path W (bbInstWeightsOf W (bbInstSeqWit W a b c f g u v)) (bbInstWeightsOf W u) :=
  fun W a b c f g u v p => refl
def bbInstSeqWitEval : (W : Type 0) -> (a b c : Shape) -> (f : Circuit a b) -> (g : Circuit b c) -> (u v : Prod W (List (Stage Nat))) -> Path (Tensor Nat c) (bbInstEval W a c (circSeq a b c f g) (bbInstSeqWit W a b c f g u v)) (bbInstEval W b c g v) :=
  fun W a b c f g u v => refl
def bbInstSeqWitSat : (W : Type 0) -> (rd : W -> BbWeights) -> (a b c : Shape) -> (f : Circuit a b) -> (g : Circuit b c) -> (x : Tensor Nat a) -> (u v : Prod W (List (Stage Nat))) -> Path W (bbInstWeightsOf W u) (bbInstWeightsOf W v) -> bbInstSat W rd a b f x u -> bbInstSat W rd b c g (bbInstEval W a b f u) v -> bbInstSat W rd a c (circSeq a b c f g) x (bbInstSeqWit W a b c f g u v) :=
  fun W rd a b c f g x u v p hu hv => trans (cong (fun (y : Tensor Nat b) => bbRun b c g (rd (first u)) y) hu) (trans (cong (fun (z : W) => bbRun b c g (rd z) (bbInstEval W a b f u)) p) hv)
-- bbInstSeqSat: u is the weights of w and one stage with the result of f at x.
-- v is w.
def bbInstSeqSat : (W : Type 0) -> (rd : W -> BbWeights) -> (a b c : Shape) -> (f : Circuit a b) -> (g : Circuit b c) -> (x : Tensor Nat a) -> (w : Prod W (List (Stage Nat))) -> bbInstSat W rd a c (circSeq a b c f g) x w -> Trunc (Sigma (u : Prod W (List (Stage Nat))) (Sigma (v : Prod W (List (Stage Nat))) (Prod (Path (Prod W (List (Stage Nat))) w (bbInstSeqWit W a b c f g u v)) (Prod (Path W (bbInstWeightsOf W u) (bbInstWeightsOf W v)) (Prod (bbInstSat W rd a b f x u) (bbInstSat W rd b c g (bbInstEval W a b f u) v)))))) :=
  fun W rd a b c f g x w h => truncIn (Sigma (u : Prod W (List (Stage Nat))) (Sigma (v : Prod W (List (Stage Nat))) (Prod (Path (Prod W (List (Stage Nat))) w (bbInstSeqWit W a b c f g u v)) (Prod (Path W (bbInstWeightsOf W u) (bbInstWeightsOf W v)) (Prod (bbInstSat W rd a b f x u) (bbInstSat W rd b c g (bbInstEval W a b f u) v))))))
    (pack (pair (first w) (cons (stageEnc Nat b (bbRun a b f (rd (first w)) x)) nil)) (pack w (pair refl (pair refl (pair (symm (stageDecEnc Nat 0 b (bbRun a b f (rd (first w)) x))) (trans (cong (fun (y : Tensor Nat b) => bbRun b c g (rd (first w)) y) (stageDecEnc Nat 0 b (bbRun a b f (rd (first w)) x))) h))))))
-- bbInst: the BabyBear Inst at the weights type W. A concrete Inst exists (flag 15).
-- rd reads the matrices of opMatMul from W (Z6f).
def bbInst : (W : Type 0) -> (W -> BbWeights) -> Inst := fun W rd => mkInst Nat (Prod W (List (Stage Nat))) W (bbInstWeightsOf W) (bbInstSat W rd) (bbInstEval W) (bbInstInputWit W) (bbInstInputWeights W) (bbInstInputSat W rd) (bbInstInputEval W) (bbInstIdSound W rd) (bbInstSeqWit W) (bbInstSeqSat W rd) (bbInstSeqWitWeights W) (bbInstSeqWitSat W rd) (bbInstSeqWitEval W) bbInstTensorSet
-- bbNoWeights: the reader with no matrices, for the circuits without opMatMul.
def bbNoWeights : (W : Type 0) -> W -> BbWeights := fun W w => nil
-- The BabyBear trace and its witness words (Z7b: D3 (a), D4, flag 62 (a)).
-- listAppend: the elements of xs, then the elements of ys.
def listAppend : (A : Type 0) -> List A -> List A -> List A := fun A xs ys => fold (fun (h : A) (acc : List A) => cons h acc) ys xs
-- listConcat: the lists of xss, one after the other.
def listConcat : (A : Type 0) -> List (List A) -> List A := fun A xss => fold (fun (h : List A) (acc : List A) => listAppend A h acc) nil xss
-- flatT: the entries of a tensor in row-major order.
def flatT : (A : Type 0) -> (s : Shape) -> Tensor A s -> List A :=
  fun A s => fold (fun (l : List Nat) => TensorL A l -> List A) (fun (d : Nat) => fun (l : List Nat) => fun (ih : TensorL A l -> List A) => fun (x : List (TensorL A l)) => fold (fun (t : TensorL A l) (acc : List A) => listAppend A (ih t) acc) nil x) (fun (a : A) => cons a nil) (dims s)
-- stageWords: the words of one stage (D4): the rank, the dims, the aux word 0,
-- then the entries in row-major order.
def stageWords : (s : Shape) -> Tensor Nat s -> List Nat :=
  fun s x => cons (listLen Nat (dims s)) (listAppend Nat (dims s) (cons 0 (flatT Nat s x)))
-- bbTraceK: the trace fold in continuation-passing style (flag 62 (a)). An op
-- or a residual puts its stage words in front of the words that the
-- continuation k gives. The seq case gives seqF a continuation that runs seqG.
-- The idl, idr and assoc ends are equal by beta and eta. The squash case uses
-- isSetPi three times and isSetList.
def bbTraceK : (a b : Shape) -> Circuit a b -> BbWeights -> Tensor Nat a -> (Tensor Nat b -> List (List Nat)) -> List (List Nat) :=
  fun a b f => fold (fun (a : Shape) => fun (b : Shape) => BbWeights -> Tensor Nat a -> (Tensor Nat b -> List (List Nat)) -> List (List Nat))
    (fun idA => fun (ws : BbWeights) => fun (x : Tensor Nat idA) => fun (k : Tensor Nat idA -> List (List Nat)) => k x)
    (fun seqA seqB seqC seqF seqG => fun (ws : BbWeights) => fun (x : Tensor Nat seqA) => fun (k : Tensor Nat seqC -> List (List Nat)) => seqF ws x (fun (y : Tensor Nat seqB) => seqG ws y k))
    (fun opA opB opO => fun (ws : BbWeights) => fun (x : Tensor Nat opA) => fun (k : Tensor Nat opB -> List (List Nat)) => (fun (y : Tensor Nat opB) => cons (stageWords opB y) (k y)) (bbOpRun opA opB opO ws x))
    (fun rsS rsF => fun (ws : BbWeights) => fun (x : Tensor Nat rsS) => fun (k : Tensor Nat rsS -> List (List Nat)) => rsF ws x (fun (y : Tensor Nat rsS) => (fun (r : Tensor Nat rsS) => cons (stageWords rsS r) (k r)) (zipWithT Nat Nat Nat bbAdd rsS x y)))
    (fun idlA idlB idlF => <i> idlF)
    (fun idrA idrB idrF => <i> idrF)
    (fun asA asB asC asD asF asG asH => <i> fun (ws : BbWeights) => fun (x : Tensor Nat asA) => fun (k : Tensor Nat asD -> List (List Nat)) => asF ws x (fun (y : Tensor Nat asB) => asG ws y (fun (z : Tensor Nat asC) => asH ws z k)))
    (fun sqA sqB sqF sqG sqP sqQ => isSetPi BbWeights (fun (v : BbWeights) => Tensor Nat sqA -> (Tensor Nat sqB -> List (List Nat)) -> List (List Nat)) (fun (v : BbWeights) => isSetPi (Tensor Nat sqA) (fun (y : Tensor Nat sqA) => (Tensor Nat sqB -> List (List Nat)) -> List (List Nat)) (fun (y : Tensor Nat sqA) => isSetPi (Tensor Nat sqB -> List (List Nat)) (fun (k : Tensor Nat sqB -> List (List Nat)) => List (List Nat)) (fun (k : Tensor Nat sqB -> List (List Nat)) => isSetList (List Nat) (isSetList Nat natIsSet)))) sqF sqG sqP sqQ) f
-- bbTrace: the stage words of each op and each residual of f at x, in run order.
def bbTrace : (a b : Shape) -> Circuit a b -> BbWeights -> Tensor Nat a -> List (List Nat) :=
  fun a b f ws x => bbTraceK a b f ws x (fun (y : Tensor Nat b) => nil)
-- matWords: the words of one matrix: the rank 2, the row count, the column
-- count, then the entries in row-major order.
def matWords : List (List Nat) -> List Nat :=
  fun m => cons 2 (cons (listLen (List Nat) m) (cons (listLen Nat (listAt (List Nat) nil 0 m)) (listConcat Nat m)))
-- bbWitnessWords: the three header words (D4), the matrix count, the words of
-- each matrix, the stage count, then the words of each stage.
def bbWitnessWords : BbWeights -> List (List Nat) -> List Nat :=
  fun ws tr => cons 1 (cons 1 (cons 1 (cons (listLen (List (List Nat)) ws) (listAppend Nat (listConcat Nat (map (fun (m : List (List Nat)) => matWords m) ws)) (cons (listLen (List Nat) tr) (listConcat Nat tr))))))
-- listLast: the last element of xs, or none if xs is nil.
def listLast : (A : Type 0) -> List A -> Option A :=
  fun A xs => fold (fun (h : A) (acc : Option A) => option (some h) (fun (t : A) => some t) acc) none xs
-- BN254 scalar field Fr (Z6h). r = 21888242871839275222246405745257275088548364400416034343698204186575808495617.
-- An element is 8 little-endian limbs below 2^32 (flag 38). The field operators
-- take canonical inputs (flag 40): limbs below 2^32 and a value below r.
family Fr := frMk (fr0 fr1 fr2 fr3 fr4 fr5 fr6 fr7 : Nat)
-- frB is the limb base 2^32. frNP is -r^-1 mod 2^32. frRL is r and frR2L is
-- 2^512 mod r, as limb lists.
def frB : Nat := 4294967296
def frNP : Nat := 4026531839
def frRL : List Nat := cons 4026531841 (cons 1138881939 (cons 2042196113 (cons 674490440 (cons 2172737629 (cons 3092268470 (cons 3778125865 (cons 811880050 (nil))))))))
def frR2L : List Nat := cons 2921426343 (cons 465102405 (cons 3814480355 (cons 1409170097 (cons 1404797061 (cons 2353627965 (cons 2135835813 (cons 35049649 (nil))))))))
-- frToL and frOfL go between Fr and the limb list. listAt reads 0 past the end.
def frToL : Fr -> List Nat := fun a => cons (fr0 a) (cons (fr1 a) (cons (fr2 a) (cons (fr3 a) (cons (fr4 a) (cons (fr5 a) (cons (fr6 a) (cons (fr7 a) (nil))))))))
def frOfL : List Nat -> Fr := fun l => frMk (listAt Nat 0 0 l) (listAt Nat 0 1 l) (listAt Nat 0 2 l) (listAt Nat 0 3 l) (listAt Nat 0 4 l) (listAt Nat 0 5 l) (listAt Nat 0 6 l) (listAt Nat 0 7 l)
-- The row folds are in CPS: a step takes the continuation k and the carry.
-- frMacRow u xs ts c is ts + u * xs + c, limb by limb; the result is the
-- carry-out and the limbs. frSubRow xs ys is xs - ys with a borrow chain; the
-- result is the borrow-out (1 when xs < ys) and the limbs.
def frNilK : Nat -> Prod Nat (List Nat) := fun c => pair c nil
def frNil2 : Prod (List Nat) (List Nat) := pair nil nil
def frCons : Nat -> Prod Nat (List Nat) -> Prod Nat (List Nat) := fun l r => pair (first r) (cons l (second r))
def frMacStep : (Nat -> Prod Nat (List Nat)) -> Nat -> Prod Nat (List Nat) := fun k s => frCons (natMod s frB) (k (natDiv s frB))
def frMacRow : Nat -> List Nat -> List Nat -> Nat -> Prod Nat (List Nat) :=
  fun u xs ts => fold (fun (p : Prod Nat Nat) (k : Nat -> Prod Nat (List Nat)) => fun (c : Nat) => frMacStep k (natAdd (natAdd (first p) (natMul u (second p))) c)) frNilK (listZipWith Nat Nat (Prod Nat Nat) (fun (t : Nat) (x : Nat) => pair t x) ts xs)
def frSubStep : (Nat -> Prod Nat (List Nat)) -> Nat -> Prod Nat (List Nat) := fun k s => frCons (natMod s frB) (k (natSub 1 (natDiv s frB)))
def frSubRow : List Nat -> List Nat -> Prod Nat (List Nat) :=
  fun xs ys => fold (fun (p : Prod Nat Nat) (k : Nat -> Prod Nat (List Nat)) => fun (c : Nat) => frSubStep k (natSub (natAdd (first p) frB) (natAdd (second p) c))) frNilK (listZipWith Nat Nat (Prod Nat Nat) (fun (x : Nat) (y : Nat) => pair x y) xs ys) 0
-- frTail drops the first limb, frSnoc appends one, frRev reverses.
def frTail : List Nat -> List Nat := fun xs => second (fold (fun (h : Nat) (acc : Prod (List Nat) (List Nat)) => pair (cons h (first acc)) (first acc)) frNil2 xs)
def frSnoc : List Nat -> Nat -> List Nat := fun xs x => fold (fun (h : Nat) (acc : List Nat) => cons h acc) (cons x nil) xs
def frRev : List Nat -> List Nat := fun xs => fold (fun (h : Nat) (acc : List Nat) => frSnoc acc h) nil xs
-- frReduce t is t - r when t >= r (the borrow of frSubRow is 0), else t.
def frPick : Prod Nat (List Nat) -> List Nat -> List Nat := fun d t => listZipWith Nat Nat Nat (fun (x : Nat) (y : Nat) => flagIf (natEq (first d) 0) x y) (second d) t
def frReduce : List Nat -> List Nat := fun t => frPick (frSubRow t frRL) t
-- Montgomery CIOS (flag 39): frMont a b = a * b * 2^-256 mod r in 8 rounds. A
-- round adds b_i * a (frMacRow), then m * r with m = t_0 * frNP mod 2^32
-- (frMontRed), and drops one limb (frMontShift). The carry rides in the first
-- component.
def frMontShift : Nat -> Nat -> Prod Nat (List Nat) -> Prod Nat (List Nat) :=
  fun tN1 tN r2 => pair (natAdd tN1 (natDiv (natAdd tN (first r2)) frB)) (frSnoc (frTail (second r2)) (natMod (natAdd tN (first r2)) frB))
def frMontRed : Prod (Prod Nat Nat) (List Nat) -> Prod Nat (List Nat) :=
  fun u => frMontShift (first (first u)) (second (first u)) (frMacRow (natMod (natMul (listAt Nat 0 0 (second u)) frNP) frB) frRL (second u) 0)
def frMontAdd : Prod Nat (List Nat) -> Nat -> Prod (Prod Nat Nat) (List Nat) :=
  fun r tN => pair (pair (natDiv (natAdd tN (first r)) frB) (natMod (natAdd tN (first r)) frB)) (second r)
def frMontStep : List Nat -> Nat -> Prod Nat (List Nat) -> Prod Nat (List Nat) :=
  fun a bi t => frMontRed (frMontAdd (frMacRow bi a (second t) 0) (first t))
def frMont : List Nat -> List Nat -> Prod Nat (List Nat) :=
  fun a b => fold (fun (bi : Nat) (t : Prod Nat (List Nat)) => frMontStep a bi t) (pair 0 (listRep Nat 8 0)) (frRev b)
-- frMulL a b = frMont (frMont a b) R^2 brings the product back to the plain form.
def frAddL : List Nat -> List Nat -> List Nat := fun a b => frReduce (second (frMacRow 1 b a 0))
def frSubL : List Nat -> List Nat -> List Nat := fun a b => frAddL a (second (frSubRow frRL b))
def frMulL : List Nat -> List Nat -> List Nat := fun a b => frReduce (second (frMont (frReduce (second (frMont a b))) frR2L))
-- The field operators on Fr. frNeg a = 0 - a.
def frAdd : Fr -> Fr -> Fr := fun a b => frOfL (frAddL (frToL a) (frToL b))
def frSub : Fr -> Fr -> Fr := fun a b => frOfL (frSubL (frToL a) (frToL b))
def frMul : Fr -> Fr -> Fr := fun a b => frOfL (frMulL (frToL a) (frToL b))
def frZero : Fr := frMk 0 0 0 0 0 0 0 0
def frOne : Fr := frMk 1 0 0 0 0 0 0 0
def frNeg : Fr -> Fr := fun a => frSub frZero a
-- isSetFr: a square in Fr is a record of squares in Nat (natIsSet).
def isSetFr : isSet Fr :=
  fun x y p q => <i> <j> frMk (natIsSet (fr0 x) (fr0 y) (<k> fr0 (p @ k)) (<k> fr0 (q @ k)) @ i @ j)
    (natIsSet (fr1 x) (fr1 y) (<k> fr1 (p @ k)) (<k> fr1 (q @ k)) @ i @ j)
    (natIsSet (fr2 x) (fr2 y) (<k> fr2 (p @ k)) (<k> fr2 (q @ k)) @ i @ j)
    (natIsSet (fr3 x) (fr3 y) (<k> fr3 (p @ k)) (<k> fr3 (q @ k)) @ i @ j)
    (natIsSet (fr4 x) (fr4 y) (<k> fr4 (p @ k)) (<k> fr4 (q @ k)) @ i @ j)
    (natIsSet (fr5 x) (fr5 y) (<k> fr5 (p @ k)) (<k> fr5 (q @ k)) @ i @ j)
    (natIsSet (fr6 x) (fr6 y) (<k> fr6 (p @ k)) (<k> fr6 (q @ k)) @ i @ j)
    (natIsSet (fr7 x) (fr7 y) (<k> fr7 (p @ k)) (<k> fr7 (q @ k)) @ i @ j)
-- frTensorSet is the instTensorSet of frInst.
def frTensorSet : (s : Shape) -> isSet (Tensor Fr s) := fun s => isSetTensor Fr isSetFr s
-- frAtLeastR compares limbs from the most significant end. It uses comparisons
-- rather than subtraction so that full-width Nat limbs cannot overflow.
def frAtLeastR : Fr -> Nat := fun a => fold (fun (p : Prod Nat Nat) (acc : Nat) => flagIf (natEq (first p) (second p)) acc (flagIf (natLe (first p) (second p)) 0 1)) 1 (listZipWith Nat Nat (Prod Nat Nat) (fun (x : Nat) (y : Nat) => pair x y) (frRev (frToL a)) (frRev frRL))
-- frBad a counts the limbs of a at 2^32 or above, plus frAtLeastR a.
-- frCanonB a is the Flag frBad a = 0 and frCanon a
-- is the type of a proof of it (flag 40). frInstSat has no frCanon clause: the
-- Inst family quantifies instInputSat over every x, canonical or not.
def frBad : Fr -> Nat := fun a => natAdd (fold (fun (x : Nat) (acc : Nat) => natAdd acc (flagIf (natLe x 4294967295) 0 1)) 0 (frToL a)) (frAtLeastR a)
def frCanonB : Fr -> Flag := fun a => natEq (frBad a) 0
def frCanon : Fr -> Type 0 := fun a => Path Flag (frCanonB a) (natEq 0 0)
-- The BN254 Inst fields (Z6h), in the form of the BabyBear Inst. The weights
-- type W is an argument. A witness is the weights and a trace of stages over Fr.
def frInstInputWit : (W : Type 0) -> (s : Shape) -> W -> Tensor Fr s -> Prod W (List (Stage Fr)) :=
  fun W s ws x => pair ws (cons (stageEnc Fr s x) nil)
-- frInstEval reads the last stage at the shape b. The empty trace gives zeroT Fr frZero.
def frInstEval : (W : Type 0) -> (a b : Shape) -> Circuit a b -> Prod W (List (Stage Fr)) -> Tensor Fr b :=
  fun W a b f w => option (zeroT Fr frZero b) (fun (st : Stage Fr) => stageDec Fr frZero b st) (stageLast Fr (second w))
-- frInstInputEval: the input witness has one stage, so the read is the round trip.
def frInstInputEval : (W : Type 0) -> (s : Shape) -> (ws : W) -> (x : Tensor Fr s) -> Path (Tensor Fr s) (frInstEval W s s (circId s) (frInstInputWit W s ws x)) x :=
  fun W s ws x => stageDecEnc Fr frZero s x
-- FrWeights: the weights of frRun, a list of matrices over Fr (the BbWeights form).
def FrWeights : Type 0 := List (List (List Fr))
-- frDot, frMatVec (Z6i): the bbDot and bbMatVec forms over Fr. frDot stops at
-- the shorter list.
def frDot : List Fr -> List Fr -> Fr := fun r x => fold (fun (h : Fr) (acc : Fr) => frAdd h acc) frZero (listZipWith Fr Fr Fr frMul r x)
def frMatVec : List (List Fr) -> List Fr -> List Fr := fun mt x => map (fun (r : List Fr) => frDot r x) mt
-- frDiff a b counts the limbs where a and b differ. frEqB a b is the Flag that
-- the count is 0: two canonical values are equal when their limbs are (flag 45).
def frDiff : Fr -> Fr -> Nat := fun a b => fold (fun (p : Prod Nat Nat) (acc : Nat) => natAdd acc (flagIf (natEq (first p) (second p)) 0 1)) 0 (listZipWith Nat Nat (Prod Nat Nat) (fun (x : Nat) (y : Nat) => pair x y) (frToL a) (frToL b))
def frEqB : Fr -> Fr -> Flag := fun a b => natEq (frDiff a b) 0
-- frTableRow and frLookup: the bbTableRow and bbLookup forms over Fr. frLookup
-- tb d v is the value of the first row [v, e] of tb (frEqB on the key), or d.
def frTableRow : List Fr -> Option (Prod Fr Fr) :=
  fun r => fold (fun (l : List Fr) => Option (Prod Fr Fr)) (fun (h : Fr) => fun (t : List Fr) => fun (ih : Option (Prod Fr Fr)) => fold (fun (e : Fr) (acc : Option (Prod Fr Fr)) => some (pair h e)) none t) none r
def frLookup : List (List Fr) -> Fr -> Fr -> Fr :=
  fun tb d v => fold (fun (r : List Fr) (acc : Fr) => option acc (fun (kv : Prod Fr Fr) => flagIf (frEqB (first kv) v) (second kv) acc) (frTableRow r)) d tb
-- frOpRun: the function of an operator at the weights ws over Fr, by an Op fold
-- (Z6i). opMatMul gives frMatVec over the weights at mmK (slice ZL).
-- opLookup s t reads the table t of ws and gives frZero for a missing
-- key. opQuantize, opSoftmax, opLayerNorm and opAttention need a Nat division
-- or a Nat order, which Fr does not have, and give zeroT Fr frZero (flags 44,
-- 46, 47, 48).
def frOpRun : (a b : Shape) -> Op a b -> FrWeights -> Tensor Fr a -> Tensor Fr b :=
  fun a b o => fold (fun (a : Shape) => fun (b : Shape) => FrWeights -> Tensor Fr a -> Tensor Fr b)
    (fun qzS qzK => fun (ws : FrWeights) => fun (x : Tensor Fr qzS) => zeroT Fr frZero qzS)
    (fun mmN mmM mmK => fun (ws : FrWeights) => fun (x : Tensor Fr (shape (cons mmN nil))) => frMatVec (listAt (List (List Fr)) nil mmK ws) x)
    (fun lkS lkT => fun (ws : FrWeights) => mapT Fr Fr (fun (v : Fr) => frLookup (listAt (List (List Fr)) nil lkT ws) frZero v) lkS)
    (fun smS smT smK => fun (ws : FrWeights) => fun (x : Tensor Fr smS) => zeroT Fr frZero smS)
    (fun lnS lnG lnT => fun (ws : FrWeights) => fun (x : Tensor Fr lnS) => zeroT Fr frZero lnS)
    (fun atH atD atQ atK atV atT atE => fun (ws : FrWeights) => fun (x : Tensor Fr (shape (cons atH (cons atD nil)))) => zeroT Fr frZero (shape (cons atH (cons atD nil)))) o
-- frRun: the cases of bbRun over Fr (flag 41). circResidual adds x with frAdd.
-- circOp runs frOpRun (Z6i).
def frRun : (a b : Shape) -> Circuit a b -> FrWeights -> Tensor Fr a -> Tensor Fr b :=
  fun a b f => fold (fun (a : Shape) => fun (b : Shape) => FrWeights -> Tensor Fr a -> Tensor Fr b)
    (fun idA => fun (ws : FrWeights) => fun (x : Tensor Fr idA) => x)
    (fun seqA seqB seqC seqF seqG => fun (ws : FrWeights) => fun (x : Tensor Fr seqA) => seqG ws (seqF ws x))
    (fun opA opB opO => frOpRun opA opB opO)
    (fun rsS rsF => fun (ws : FrWeights) => fun (x : Tensor Fr rsS) => zipWithT Fr Fr Fr frAdd rsS x (rsF ws x))
    (fun idlA idlB idlF => <i> idlF)
    (fun idrA idrB idrF => <i> idrF)
    (fun asA asB asC asD asF asG asH => <i> fun (ws : FrWeights) => fun (x : Tensor Fr asA) => asH ws (asG ws (asF ws x)))
    (fun sqA sqB sqF sqG sqP sqQ => isSetPi FrWeights (fun (v : FrWeights) => Tensor Fr sqA -> Tensor Fr sqB) (fun (v : FrWeights) => isSetPi (Tensor Fr sqA) (fun (y : Tensor Fr sqA) => Tensor Fr sqB) (fun (y : Tensor Fr sqA) => frTensorSet sqB)) sqF sqG sqP sqQ) f
-- The BN254 trace and its witness words (Z7c: D4, D5 (a)). An Fr element
-- gives 8 words: the limbs fr0 .. fr7, low first (D4).
-- frWords: the limbs of each element of xs, low first.
def frWords : List Fr -> List Nat := fun xs => listConcat Nat (map (fun (v : Fr) => frToL v) xs)
-- frStageWords: the words of one Fr stage: the rank, the dims, the aux word 0,
-- then the limbs of the entries in row-major order.
def frStageWords : (s : Shape) -> Tensor Fr s -> List Nat :=
  fun s x => cons (listLen Nat (dims s)) (listAppend Nat (dims s) (cons 0 (frWords (flatT Fr s x))))
-- frTraceK: the bbTraceK fold over Fr. It runs the ops of frRun (flag 59 (a)).
def frTraceK : (a b : Shape) -> Circuit a b -> FrWeights -> Tensor Fr a -> (Tensor Fr b -> List (List Nat)) -> List (List Nat) :=
  fun a b f => fold (fun (a : Shape) => fun (b : Shape) => FrWeights -> Tensor Fr a -> (Tensor Fr b -> List (List Nat)) -> List (List Nat))
    (fun idA => fun (ws : FrWeights) => fun (x : Tensor Fr idA) => fun (k : Tensor Fr idA -> List (List Nat)) => k x)
    (fun seqA seqB seqC seqF seqG => fun (ws : FrWeights) => fun (x : Tensor Fr seqA) => fun (k : Tensor Fr seqC -> List (List Nat)) => seqF ws x (fun (y : Tensor Fr seqB) => seqG ws y k))
    (fun opA opB opO => fun (ws : FrWeights) => fun (x : Tensor Fr opA) => fun (k : Tensor Fr opB -> List (List Nat)) => (fun (y : Tensor Fr opB) => cons (frStageWords opB y) (k y)) (frOpRun opA opB opO ws x))
    (fun rsS rsF => fun (ws : FrWeights) => fun (x : Tensor Fr rsS) => fun (k : Tensor Fr rsS -> List (List Nat)) => rsF ws x (fun (y : Tensor Fr rsS) => (fun (r : Tensor Fr rsS) => cons (frStageWords rsS r) (k r)) (zipWithT Fr Fr Fr frAdd rsS x y)))
    (fun idlA idlB idlF => <i> idlF)
    (fun idrA idrB idrF => <i> idrF)
    (fun asA asB asC asD asF asG asH => <i> fun (ws : FrWeights) => fun (x : Tensor Fr asA) => fun (k : Tensor Fr asD -> List (List Nat)) => asF ws x (fun (y : Tensor Fr asB) => asG ws y (fun (z : Tensor Fr asC) => asH ws z k)))
    (fun sqA sqB sqF sqG sqP sqQ => isSetPi FrWeights (fun (v : FrWeights) => Tensor Fr sqA -> (Tensor Fr sqB -> List (List Nat)) -> List (List Nat)) (fun (v : FrWeights) => isSetPi (Tensor Fr sqA) (fun (y : Tensor Fr sqA) => (Tensor Fr sqB -> List (List Nat)) -> List (List Nat)) (fun (y : Tensor Fr sqA) => isSetPi (Tensor Fr sqB -> List (List Nat)) (fun (k : Tensor Fr sqB -> List (List Nat)) => List (List Nat)) (fun (k : Tensor Fr sqB -> List (List Nat)) => isSetList (List Nat) (isSetList Nat natIsSet)))) sqF sqG sqP sqQ) f
-- frTrace: the stage words of each op and each residual of f at x, in run order.
def frTrace : (a b : Shape) -> Circuit a b -> FrWeights -> Tensor Fr a -> List (List Nat) :=
  fun a b f ws x => frTraceK a b f ws x (fun (y : Tensor Fr b) => nil)
-- frMatWords: the words of one Fr matrix: the rank 2, the row count, the column
-- count, then the limbs of the entries in row-major order.
def frMatWords : List (List Fr) -> List Nat :=
  fun m => cons 2 (cons (listLen (List Fr) m) (cons (listLen Fr (listAt (List Fr) nil 0 m)) (frWords (listConcat Fr m))))
-- frWitnessWords: the header words (D4: version 1, field id 2 for BN254, 8 words
-- for each element), the matrix count, the words of each matrix, the stage
-- count, then the words of each stage.
def frWitnessWords : FrWeights -> List (List Nat) -> List Nat :=
  fun ws tr => cons 1 (cons 2 (cons 8 (cons (listLen (List (List Fr)) ws) (listAppend Nat (listConcat Nat (map (fun (m : List (List Fr)) => frMatWords m) ws)) (cons (listLen (List Nat) tr) (listConcat Nat tr))))))
-- frInstSat: the last stage of w gives frRun at the weights of w (no frCanon clause, flag 40).
def frInstSat : (W : Type 0) -> (W -> FrWeights) -> (a b : Shape) -> Circuit a b -> Tensor Fr a -> Prod W (List (Stage Fr)) -> Type 0 :=
  fun W rd a b f x w => Path (Tensor Fr b) (frRun a b f (rd (first w)) x) (frInstEval W a b f w)
def frInstWeightsOf : (W : Type 0) -> Prod W (List (Stage Fr)) -> W := fun W w => first w
def frInstInputWeights : (W : Type 0) -> (s : Shape) -> (ws : W) -> (x : Tensor Fr s) -> Path W (frInstWeightsOf W (frInstInputWit W s ws x)) ws := fun W s ws x => refl
-- The input witness satisfies circId by the round trip of its stage.
def frInstInputSat : (W : Type 0) -> (rd : W -> FrWeights) -> (s : Shape) -> (ws : W) -> (x : Tensor Fr s) -> frInstSat W rd s s (circId s) x (frInstInputWit W s ws x) := fun W rd s ws x => symm (frInstInputEval W s ws x)
def frInstIdSound : (W : Type 0) -> (rd : W -> FrWeights) -> (s : Shape) -> (x : Tensor Fr s) -> (w : Prod W (List (Stage Fr))) -> frInstSat W rd s s (circId s) x w -> Path (Tensor Fr s) x (frInstEval W s s (circId s) w) := fun W rd s x w h => h
-- frInstSeqWit keeps the weights of u and the trace of v, as bbInstSeqWit.
def frInstSeqWit : (W : Type 0) -> (a b c : Shape) -> Circuit a b -> Circuit b c -> Prod W (List (Stage Fr)) -> Prod W (List (Stage Fr)) -> Prod W (List (Stage Fr)) :=
  fun W a b c f g u v => pair (first u) (second v)
def frInstSeqWitWeights : (W : Type 0) -> (a b c : Shape) -> (f : Circuit a b) -> (g : Circuit b c) -> (u v : Prod W (List (Stage Fr))) -> Path W (frInstWeightsOf W u) (frInstWeightsOf W v) -> Path W (frInstWeightsOf W (frInstSeqWit W a b c f g u v)) (frInstWeightsOf W u) :=
  fun W a b c f g u v p => refl
def frInstSeqWitEval : (W : Type 0) -> (a b c : Shape) -> (f : Circuit a b) -> (g : Circuit b c) -> (u v : Prod W (List (Stage Fr))) -> Path (Tensor Fr c) (frInstEval W a c (circSeq a b c f g) (frInstSeqWit W a b c f g u v)) (frInstEval W b c g v) :=
  fun W a b c f g u v => refl
def frInstSeqWitSat : (W : Type 0) -> (rd : W -> FrWeights) -> (a b c : Shape) -> (f : Circuit a b) -> (g : Circuit b c) -> (x : Tensor Fr a) -> (u v : Prod W (List (Stage Fr))) -> Path W (frInstWeightsOf W u) (frInstWeightsOf W v) -> frInstSat W rd a b f x u -> frInstSat W rd b c g (frInstEval W a b f u) v -> frInstSat W rd a c (circSeq a b c f g) x (frInstSeqWit W a b c f g u v) :=
  fun W rd a b c f g x u v p hu hv => trans (cong (fun (y : Tensor Fr b) => frRun b c g (rd (first u)) y) hu) (trans (cong (fun (z : W) => frRun b c g (rd z) (frInstEval W a b f u)) p) hv)
-- frInstSeqSat: u is the weights of w and one stage with the result of f at x. v is w.
def frInstSeqSat : (W : Type 0) -> (rd : W -> FrWeights) -> (a b c : Shape) -> (f : Circuit a b) -> (g : Circuit b c) -> (x : Tensor Fr a) -> (w : Prod W (List (Stage Fr))) -> frInstSat W rd a c (circSeq a b c f g) x w -> Trunc (Sigma (u : Prod W (List (Stage Fr))) (Sigma (v : Prod W (List (Stage Fr))) (Prod (Path (Prod W (List (Stage Fr))) w (frInstSeqWit W a b c f g u v)) (Prod (Path W (frInstWeightsOf W u) (frInstWeightsOf W v)) (Prod (frInstSat W rd a b f x u) (frInstSat W rd b c g (frInstEval W a b f u) v)))))) :=
  fun W rd a b c f g x w h => truncIn (Sigma (u : Prod W (List (Stage Fr))) (Sigma (v : Prod W (List (Stage Fr))) (Prod (Path (Prod W (List (Stage Fr))) w (frInstSeqWit W a b c f g u v)) (Prod (Path W (frInstWeightsOf W u) (frInstWeightsOf W v)) (Prod (frInstSat W rd a b f x u) (frInstSat W rd b c g (frInstEval W a b f u) v))))))
    (pack (pair (first w) (cons (stageEnc Fr b (frRun a b f (rd (first w)) x)) nil)) (pack w (pair refl (pair refl (pair (symm (stageDecEnc Fr frZero b (frRun a b f (rd (first w)) x))) (trans (cong (fun (y : Tensor Fr b) => frRun b c g (rd (first w)) y) (stageDecEnc Fr frZero b (frRun a b f (rd (first w)) x))) h))))))
-- frInst: the BN254 Inst at the weights type W. rd reads the matrices from W.
def frInst : (W : Type 0) -> (W -> FrWeights) -> Inst := fun W rd => mkInst Fr (Prod W (List (Stage Fr))) W (frInstWeightsOf W) (frInstSat W rd) (frInstEval W) (frInstInputWit W) (frInstInputWeights W) (frInstInputSat W rd) (frInstInputEval W) (frInstIdSound W rd) (frInstSeqWit W) (frInstSeqSat W rd) (frInstSeqWitWeights W) (frInstSeqWitSat W rd) (frInstSeqWitEval W) frTensorSet
-- frNoWeights: the reader with no matrices.
def frNoWeights : (W : Type 0) -> W -> FrWeights := fun W w => nil
-- isPropSquareP: a square of propositions has a filler for any four sides.
-- The base is a transp of the corner b00. Each side is a path of the proposition from the base.
def isPropSquareP : (B : I -> I -> Type 0) -> ((j : I) -> (i : I) -> isProp (B j i)) -> (b00 : B i0 i0) -> (b01 : B i0 i1) -> (b10 : B i1 i0) -> (b11 : B i1 i1) -> (t : PathP (fun (i : I) => B i0 i) b00 b01) -> (u : PathP (fun (i : I) => B i1 i) b10 b11) -> (r : PathP (fun (j : I) => B j i0) b00 b10) -> (s : PathP (fun (j : I) => B j i1) b01 b11) -> PathP (fun (j : I) => PathP (fun (i : I) => B j i) (r @ j) (s @ j)) t u :=
  fun B h b00 b01 b10 b11 t u r s => <j> <i> hcomp (fun k => [ ~ j |-> h i0 i (transp (fun (m : I) => B (i0 /\ m) (i /\ m)) i0 b00) (t @ i) @ k , j |-> h i1 i (transp (fun (m : I) => B (i1 /\ m) (i /\ m)) i0 b00) (u @ i) @ k , ~ i |-> h j i0 (transp (fun (m : I) => B (j /\ m) (i0 /\ m)) i0 b00) (r @ j) @ k , i |-> h j i1 (transp (fun (m : I) => B (j /\ m) (i1 /\ m)) i0 b00) (s @ j) @ k ]) (transp (fun (m : I) => B (j /\ m) (i /\ m)) i0 b00)
-- layerExt2: squares on the circuit, the denotation and the resources give a square in Layer (D11).
-- The soundness and completeness squares come from isPropSquareP. The Inst is K, because the body names the interval type I.
def layerExt2 : (K : Inst) -> (a b : Shape) -> (L1 L2 : Layer K a b) -> (p q : Path (Layer K a b) L1 L2) -> (sc : Path (Path (Circuit a b) (layerCircuit L1) (layerCircuit L2)) (<i> layerCircuit (p @ i)) (<i> layerCircuit (q @ i))) -> (sd : Path (Path (instWeights K -> Tensor (instF K) a -> Tensor (instF K) b) (layerDen L1) (layerDen L2)) (<i> layerDen (p @ i)) (<i> layerDen (q @ i))) -> (sr : Path (Path Resource (layerRes L1) (layerRes L2)) (<i> layerRes (p @ i)) (<i> layerRes (q @ i))) -> Path (Path (Layer K a b) L1 L2) p q :=
  fun K a b L1 L2 p q sc sd sr => <j> <i> layer K a b (sc @ j @ i) (sd @ j @ i)
    ((isPropSquareP (fun (j : I) (i : I) => layerSoundT K a b (sc @ j @ i) (sd @ j @ i)) (fun (j : I) (i : I) => layerSoundProp K a b (sc @ j @ i) (sd @ j @ i)) (layerSound L1) (layerSound L2) (layerSound L1) (layerSound L2) (<i> layerSound (p @ i)) (<i> layerSound (q @ i)) (<j> layerSound L1) (<j> layerSound L2)) @ j @ i)
    ((isPropSquareP (fun (j : I) (i : I) => layerCompleteT K a b (sc @ j @ i) (sd @ j @ i)) (fun (j : I) (i : I) => layerCompleteProp K a b (sc @ j @ i) (sd @ j @ i)) (layerComplete L1) (layerComplete L2) (layerComplete L1) (layerComplete L2) (<i> layerComplete (p @ i)) (<i> layerComplete (q @ i)) (<j> layerComplete L1) (<j> layerComplete L2)) @ j @ i)
    (sr @ j @ i)
-- isSetHom (N4): the Layer hom-sets are sets. The circuit square is circSquash, the denotation square is isSetPi
-- with instTensorSet and the resource square is isSetResource.
def isSetHom : (I : Inst) -> (a b : Shape) -> isSet (Layer I a b) :=
  fun I a b L1 L2 p q => layerExt2 I a b L1 L2 p q
    (circSquash a b (layerCircuit L1) (layerCircuit L2) (<i> layerCircuit (p @ i)) (<i> layerCircuit (q @ i)))
    (isSetPi (instWeights I) (fun ws => Tensor (instF I) a -> Tensor (instF I) b) (fun ws => isSetPi (Tensor (instF I) a) (fun x => Tensor (instF I) b) (fun x => instTensorSet I b)) (layerDen L1) (layerDen L2) (<i> layerDen (p @ i)) (<i> layerDen (q @ i)))
    (isSetResource (layerRes L1) (layerRes L2) (<i> layerRes (p @ i)) (<i> layerRes (q @ i)))
-- A category (D12). catSeq takes the order g after f, not the diagrammatic order (flag 7).
family Category := mkCat (catOb : Type 0) (catHom : catOb -> catOb -> Type 0)
  (catId : (a : catOb) -> catHom a a)
  (catSeq : (a b c : catOb) -> catHom b c -> catHom a b -> catHom a c)
  (catIdl : (a b : catOb) -> (f : catHom a b) -> Path (catHom a b) (catSeq a b b (catId b) f) f)
  (catIdr : (a b : catOb) -> (f : catHom a b) -> Path (catHom a b) (catSeq a a b f (catId a)) f)
  (catAssoc : (a b c d : catOb) -> (h : catHom c d) -> (g : catHom b c) -> (f : catHom a b) -> Path (catHom a d) (catSeq a b d (catSeq b c d h g) f) (catSeq a c d h (catSeq a b c g f)))
  (catHomSet : (a b : catOb) -> isSet (catHom a b))
-- The category of layers of an instance (D12): the laws are layerIdl, layerIdr and layerAssoc, the hom-sets isSetHom.
def LayerCat : (I : Inst) -> Category := fun I => mkCat Shape (Layer I) (idL I) (layerSeq I) (layerIdl I) (layerIdr I) (layerAssoc I) (isSetHom I)
-- A functor from a category into types (D13).
family TypeFunctor (C : Category) := mkTFun (tfOb : catOb C -> Type 0)
  (tfHom : (a b : catOb C) -> catHom C a b -> tfOb a -> tfOb b)
  (tfId : (a : catOb C) -> Path (tfOb a -> tfOb a) (tfHom a a (catId C a)) (fun (x : tfOb a) => x))
  (tfSeq : (a b c : catOb C) -> (g : catHom C b c) -> (f : catHom C a b) -> Path (tfOb a -> tfOb c) (tfHom a c (catSeq C a b c g f)) (fun (x : tfOb a) => tfHom b c g (tfHom a b f x)))
-- The denotation functor at the weights ws (D13, SPEC O1): an object is a tensor type, a layer gives its
-- denotation at ws. tfId and tfSeq hold by refl.
def denote : (I : Inst) -> instWeights I -> TypeFunctor (LayerCat I) :=
  fun I ws => mkTFun (LayerCat I) (fun (s : Shape) => Tensor (instF I) s) (fun (a b : Shape) (L : Layer I a b) => layerDen L ws) (fun (a : Shape) => refl) (fun (a b c : Shape) (g : Layer I b c) (f : Layer I a b) => refl)
-- A functor between two categories (slice Z8b): an object map, a hom map and the
-- two laws. funSeq takes the order g after f, as catSeq (flag 7).
family Functor (C D : Category) := mkFun (funOb : catOb C -> catOb D)
  (funHom : (a b : catOb C) -> catHom C a b -> catHom D (funOb a) (funOb b))
  (funId : (a : catOb C) -> Path (catHom D (funOb a) (funOb a)) (funHom a a (catId C a)) (catId D (funOb a)))
  (funSeq : (a b c : catOb C) -> (g : catHom C b c) -> (f : catHom C a b) -> Path (catHom D (funOb a) (funOb c)) (funHom a c (catSeq C a b c g f)) (catSeq D (funOb a) (funOb b) (funOb c) (funHom b c g) (funHom a b f)))
-- LLZK (slice Z8b, flags 66, 69 and 75): a guest model of an LLZK module.
-- LlzkOp a b is one block of felt ops (D9). llMatMul n m k: one felt.mul for each
-- product, a felt.add chain for each sum and one constrain.eq for each output.
-- llLookup s t: the export refuses a lookup (flag 69 (a)). llZero s: each output
-- is constrained to 0, the frRun value of quantize, softmax, layerNorm and
-- attention (flags 44 and 46 to 48).
family LlzkOp (a b : Shape) :=
    llMatMul (lmN lmM lmK : Nat) : LlzkOp (shape (cons lmN nil)) (shape (cons lmM nil))
  | llLookup (llkS : Shape) (llkT : Nat) : LlzkOp llkS llkS
  | llZero (lzS : Shape) : LlzkOp lzS lzS
-- LlzkMod a b: an LLZK module from a to b, a QIIT with the constructors of Circuit
-- (D2 (a)). llResidual f is x + f x: one felt.add and one constrain.eq for each entry.
family LlzkMod (a b : Shape) :=
    llId (lidA : Shape) : LlzkMod lidA lidA
  | llSeq (lseA lseB lseC : Shape) (lseF : LlzkMod lseA lseB) (lseG : LlzkMod lseB lseC) : LlzkMod lseA lseC
  | llOp (lopA lopB : Shape) (lopO : LlzkOp lopA lopB) : LlzkMod lopA lopB
  | llResidual (lrsS : Shape) (lrsF : LlzkMod lrsS lrsS) : LlzkMod lrsS lrsS
  | llIdl (lilA lilB : Shape) (lilF : LlzkMod lilA lilB)
      : Path (LlzkMod lilA lilB) (llSeq lilA lilA lilB (llId lilA) lilF) lilF
  | llIdr (lirA lirB : Shape) (lirF : LlzkMod lirA lirB)
      : Path (LlzkMod lirA lirB) (llSeq lirA lirB lirB lirF (llId lirB)) lirF
  | llAssoc (lasA lasB lasC lasD : Shape) (lasF : LlzkMod lasA lasB) (lasG : LlzkMod lasB lasC) (lasH : LlzkMod lasC lasD)
      : Path (LlzkMod lasA lasD) (llSeq lasA lasC lasD (llSeq lasA lasB lasC lasF lasG) lasH) (llSeq lasA lasB lasD lasF (llSeq lasB lasC lasD lasG lasH))
  | llSquash (lsqA lsqB : Shape) (lsqF lsqG : LlzkMod lsqA lsqB) (lsqP lsqQ : Path (LlzkMod lsqA lsqB) lsqF lsqG)
      : Path (Path (LlzkMod lsqA lsqB) lsqF lsqG) lsqP lsqQ
-- opLlzk: the LLZK block of an operator, by an Op fold (flag 69 (a)).
def opLlzk : (a b : Shape) -> Op a b -> LlzkOp a b :=
  fun a b o => fold (fun (a : Shape) => fun (b : Shape) => LlzkOp a b) (fun qzS qzK => llZero qzS) (fun mmN mmM mmK => llMatMul mmN mmM mmK) (fun lkS lkT => llLookup lkS lkT) (fun smS smT smK => llZero smS) (fun lnS lnG lnT => llZero lnS) (fun atH atD atQ atK atV atT atE => llZero (shape (cons atH (cons atD nil)))) o
-- exportMod: the LLZK module of a circuit, by a Circuit fold. Each constructor goes to
-- the LlzkMod constructor of the same name, thus the export of circSeq is llSeq (iota).
def exportMod : (a b : Shape) -> Circuit a b -> LlzkMod a b :=
  fun a b x => fold (fun (a : Shape) => fun (b : Shape) => LlzkMod a b) (fun idA => llId idA) (fun seqA seqB seqC seqF seqG => llSeq seqA seqB seqC seqF seqG) (fun opA opB opO => llOp opA opB (opLlzk opA opB opO)) (fun rsS rsF => llResidual rsS rsF) (fun idlA idlB idlF => llIdl idlA idlB idlF) (fun idrA idrB idrF => llIdr idrA idrB idrF) (fun asA asB asC asD asF asG asH => llAssoc asA asB asC asD asF asG asH) (fun sqA sqB sqF sqG sqP sqQ => llSquash sqA sqB sqF sqG sqP sqQ) x
-- An LLZK hom (flag 75 (a)): a module and its resources, as Layer has layerRes.
family LlzkHom (a b : Shape) := llzkHom (llzkMod : LlzkMod a b) (llzkRes : Resource)
def llzkIdH : (s : Shape) -> LlzkHom s s := fun s => llzkHom s s (llId s) zeroR
def llzkSeqH : (a b c : Shape) -> LlzkHom b c -> LlzkHom a b -> LlzkHom a c :=
  fun a b c g f => llzkHom a c (llSeq a b c (llzkMod f) (llzkMod g)) (resAdd (llzkRes g) (llzkRes f))
-- llzkExt and llzkExt2: paths and squares on the module and the resources give a path
-- and a square in LlzkHom (record eta, D5), as layerExt and layerExt2.
def llzkExt : (a b : Shape) -> (h1 h2 : LlzkHom a b) -> Path (LlzkMod a b) (llzkMod h1) (llzkMod h2) -> Path Resource (llzkRes h1) (llzkRes h2) -> Path (LlzkHom a b) h1 h2 :=
  fun a b h1 h2 pm pr => <i> llzkHom a b (pm @ i) (pr @ i)
def llzkExt2 : (a b : Shape) -> (h1 h2 : LlzkHom a b) -> (p q : Path (LlzkHom a b) h1 h2) -> (sm : Path (Path (LlzkMod a b) (llzkMod h1) (llzkMod h2)) (<i> llzkMod (p @ i)) (<i> llzkMod (q @ i))) -> (sr : Path (Path Resource (llzkRes h1) (llzkRes h2)) (<i> llzkRes (p @ i)) (<i> llzkRes (q @ i))) -> Path (Path (LlzkHom a b) h1 h2) p q :=
  fun a b h1 h2 p q sm sr => <j> <i> llzkHom a b (sm @ j @ i) (sr @ j @ i)
-- The category laws on LlzkHom: the LlzkMod path constructors and the Resource laws.
def llzkIdl : (a b : Shape) -> (f : LlzkHom a b) -> Path (LlzkHom a b) (llzkSeqH a b b (llzkIdH b) f) f :=
  fun a b f => llzkExt a b (llzkSeqH a b b (llzkIdH b) f) f (llIdr a b (llzkMod f)) (resUnitL (llzkRes f))
def llzkIdr : (a b : Shape) -> (f : LlzkHom a b) -> Path (LlzkHom a b) (llzkSeqH a a b f (llzkIdH a)) f :=
  fun a b f => llzkExt a b (llzkSeqH a a b f (llzkIdH a)) f (llIdl a b (llzkMod f)) (resUnitR (llzkRes f))
def llzkAssoc : (a b c d : Shape) -> (h : LlzkHom c d) -> (g : LlzkHom b c) -> (f : LlzkHom a b) -> Path (LlzkHom a d) (llzkSeqH a b d (llzkSeqH b c d h g) f) (llzkSeqH a c d h (llzkSeqH a b c g f)) :=
  fun a b c d h g f => llzkExt a d (llzkSeqH a b d (llzkSeqH b c d h g) f) (llzkSeqH a c d h (llzkSeqH a b c g f)) (symm (llAssoc a b c d (llzkMod f) (llzkMod g) (llzkMod h))) (resAssoc (llzkRes h) (llzkRes g) (llzkRes f))
-- llzkHomSet: the LlzkHom hom-sets are sets (llSquash and isSetResource).
def llzkHomSet : (a b : Shape) -> isSet (LlzkHom a b) :=
  fun a b h1 h2 p q => llzkExt2 a b h1 h2 p q (llSquash a b (llzkMod h1) (llzkMod h2) (<i> llzkMod (p @ i)) (<i> llzkMod (q @ i))) (isSetResource (llzkRes h1) (llzkRes h2) (<i> llzkRes (p @ i)) (<i> llzkRes (q @ i)))
-- The category of LLZK modules (D3 (a)): the objects are the shapes.
def LLZKIRCat : Category := mkCat Shape LlzkHom llzkIdH llzkSeqH llzkIdl llzkIdr llzkAssoc llzkHomSet
-- exportHom: the module of the circuit and the resources of the layer.
def exportHom : (I : Inst) -> (a b : Shape) -> Layer I a b -> LlzkHom a b :=
  fun I a b L => llzkHom a b (exportMod a b (layerCircuit L)) (layerRes L)
-- The LLZK export functor (design/DESIGN.md:189-195): funId and funSeq hold by refl.
def exportLLZK : (I : Inst) -> Functor (LayerCat I) LLZKIRCat :=
  fun I => mkFun (LayerCat I) LLZKIRCat (fun (s : Shape) => s) (exportHom I) (fun (a : Shape) => refl) (fun (a b c : Shape) (g : Layer I b c) (f : Layer I a b) => refl)
-- resourcesExport (design resources-export): the export keeps the resources of a layer.
def resourcesExport : (I : Inst) -> (a b : Shape) -> (L : Layer I a b) -> Path Resource (llzkRes (funHom (exportLLZK I) a b L)) (layerRes L) :=
  fun I a b L => refl
