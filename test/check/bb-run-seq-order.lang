-- bbRun with the seq case in the wrong order: seqF after seqG. seqG takes a
-- tensor at seqB, and x is at seqA. Refused: TYPE_MISMATCH.
def badRun : (a b : Shape) -> Circuit a b -> BbWeights -> Tensor Nat a -> Tensor Nat b :=
  fun a b f => fold (fun (a : Shape) => fun (b : Shape) => BbWeights -> Tensor Nat a -> Tensor Nat b) (fun idA => fun (ws : BbWeights) => fun (x : Tensor Nat idA) => x) (fun seqA seqB seqC seqF seqG => fun (ws : BbWeights) => fun (x : Tensor Nat seqA) => seqF ws (seqG ws x)) (fun opA opB opO => bbOpRun opA opB opO) (fun rsS rsF => fun (ws : BbWeights) => fun (x : Tensor Nat rsS) => zipWithT Nat Nat Nat bbAdd rsS x (rsF ws x)) (fun idlA idlB idlF => <i> idlF) (fun idrA idrB idrF => <i> idrF) (fun asA asB asC asD asF asG asH => <i> fun (ws : BbWeights) => fun (x : Tensor Nat asA) => asH ws (asG ws (asF ws x))) (fun sqA sqB sqF sqG sqP sqQ => isSetPi BbWeights (fun (v : BbWeights) => Tensor Nat sqA -> Tensor Nat sqB) (fun (v : BbWeights) => isSetPi (Tensor Nat sqA) (fun (y : Tensor Nat sqA) => Tensor Nat sqB) (fun (y : Tensor Nat sqA) => bbInstTensorSet sqB)) sqF sqG sqP sqQ) f
