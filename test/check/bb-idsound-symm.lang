-- bbInstIdSound with the path in the wrong direction. Refused: TYPE_MISMATCH.
def badSound : (W : Type 0) -> (rd : W -> BbWeights) -> (s : Shape) -> (x : Tensor Nat s) -> (w : Prod W (List (Stage Nat))) -> bbInstSat W rd s s (circId s) x w -> Path (Tensor Nat s) x (bbInstEval W s s (circId s) w) :=
  fun W rd s x w h => symm h
