-- A hom map that gives the resources res 1 0 0 breaks funId: the Halo2 export of idL must cost zeroR.
def badExport : (I : Inst) -> Functor (LayerCat I) Halo2CircuitCat :=
  fun I => mkFun (LayerCat I) Halo2CircuitCat (fun (s : Shape) => s) (fun (a b : Shape) (L : Layer I a b) => halo2Hom a b (exportH2Mod a b (layerCircuit L)) (res 1 0 0)) (fun (a : Shape) => refl) (fun (a b c : Shape) (g : Layer I b c) (f : Layer I a b) => refl)
