-- Witness entries: a List Nat result is a words block in the Wasm memory
-- (flag 56 (a)). The gate compares `langc eval` and run-wasm.mjs on each.
def wordsRange : (n : Nat) -> List Nat := fun (n : Nat) => unfold (fun (k : Nat) => some (pair k (natAdd k 1))) n 0
def wordsRev : (n : Nat) -> List Nat := fun (n : Nat) => unfold (fun (k : Nat) => some (pair k (natSub k 1))) n (natSub n 1)
def wordsEmpty : List Nat := nil
def wordsBig : List Nat := cons 18446744073709551615 nil
def wordsTrap : (n : Nat) -> List Nat := fun (n : Nat) => cons 1 (cons (natMul n 6148914691236517206) (cons 2 nil))
def wordsPick : (f : Flag) -> (n : Nat) -> List Nat := fun (f : Flag) (n : Nat) => wordsRange (flagIf f n 0)
-- BabyBear witness words (Z7b, D4): the words of the weights and of the trace
-- stages of small circuits. bbWitWide has a rank 2 shape that is not square.
def bbWitW : BbWeights := cons (cons (cons 1 (cons 2 (cons 3 nil))) (cons (cons 4 (cons 5 (cons 6 nil))) nil)) nil
def bbWitT : BbWeights := cons (cons (cons 0 (cons 7 nil)) (cons (cons 1 (cons 9 nil)) (cons (cons 2 (cons 11 nil)) nil))) nil
def bbWitQuant : (u : Nat) -> (v : Nat) -> List Nat := fun u v => bbWitnessWords nil (bbTrace (shape (cons 2 nil)) (shape (cons 2 nil)) (circOp (shape (cons 2 nil)) (shape (cons 2 nil)) (opQuantize (shape (cons 2 nil)) 3)) nil (cons u (cons v nil)))
def bbWitResidual : (u : Nat) -> (v : Nat) -> List Nat := fun u v => bbWitnessWords nil (bbTrace (shape (cons 2 nil)) (shape (cons 2 nil)) (circResidual (shape (cons 2 nil)) (circOp (shape (cons 2 nil)) (shape (cons 2 nil)) (opQuantize (shape (cons 2 nil)) 1))) nil (cons u (cons v nil)))
def bbWitSeq : (u : Nat) -> (v : Nat) -> List Nat := fun u v => bbWitnessWords nil (bbTrace (shape (cons 2 nil)) (shape (cons 2 nil)) (circSeq (shape (cons 2 nil)) (shape (cons 2 nil)) (shape (cons 2 nil)) (circOp (shape (cons 2 nil)) (shape (cons 2 nil)) (opQuantize (shape (cons 2 nil)) 1)) (circSeq (shape (cons 2 nil)) (shape (cons 2 nil)) (shape (cons 2 nil)) (circOp (shape (cons 2 nil)) (shape (cons 2 nil)) (opQuantize (shape (cons 2 nil)) 1)) (circResidual (shape (cons 2 nil)) (circOp (shape (cons 2 nil)) (shape (cons 2 nil)) (opQuantize (shape (cons 2 nil)) 1))))) nil (cons u (cons v nil)))
def bbWitWide : (u : Nat) -> (v : Nat) -> List Nat := fun u v => bbWitnessWords nil (bbTrace (shape (cons 2 (cons 3 nil))) (shape (cons 2 (cons 3 nil))) (circOp (shape (cons 2 (cons 3 nil))) (shape (cons 2 (cons 3 nil))) (opQuantize (shape (cons 2 (cons 3 nil))) 1)) nil (cons (cons u (cons v (cons 0 nil))) (cons (cons 2 (cons 4 (cons 6 nil))) nil)))
def bbWitMatMul : (u : Nat) -> (v : Nat) -> List Nat := fun u v => bbWitnessWords bbWitW (bbTrace (shape (cons 3 nil)) (shape (cons 2 nil)) (circOp (shape (cons 3 nil)) (shape (cons 2 nil)) (opMatMul 3 2 0)) bbWitW (cons u (cons v (cons 1 nil))))
def bbWitLookup : (u : Nat) -> (v : Nat) -> List Nat := fun u v => bbWitnessWords bbWitT (bbTrace (shape (cons 2 nil)) (shape (cons 2 nil)) (circOp (shape (cons 2 nil)) (shape (cons 2 nil)) (opLookup (shape (cons 2 nil)) 0)) bbWitT (cons u (cons v nil)))
-- bbTraceLast: the last stage of the trace is the stage of the bbRun result.
def bbTraceLast : Path (Option (List Nat)) (listLast (List Nat) (bbTrace (shape (cons 2 nil)) (shape (cons 2 nil)) (circResidual (shape (cons 2 nil)) (circOp (shape (cons 2 nil)) (shape (cons 2 nil)) (opQuantize (shape (cons 2 nil)) 1))) nil (cons 4 (cons 6 nil)))) (some (stageWords (shape (cons 2 nil)) (bbRun (shape (cons 2 nil)) (shape (cons 2 nil)) (circResidual (shape (cons 2 nil)) (circOp (shape (cons 2 nil)) (shape (cons 2 nil)) (opQuantize (shape (cons 2 nil)) 1))) nil (cons 4 (cons 6 nil))))) := refl
