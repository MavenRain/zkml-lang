-- Former C4 (higher inductive types, part Z3a): the kit domain declares
-- Circle, Trunc and Quot with path constructors. A path constructor is a
-- path value whose ends reduce by its declared type. hcomp at a HIT with
-- open faces is a formal constructor, and transp along a constant line
-- gives its argument. The eliminator (part Z3b) is `fold` with one case
-- for each constructor, the path constructors included: circleRec,
-- truncRec and quotRec below, with their reduction laws by refl.

def loop : Path Circle circleBase circleBase := circleLoop
def loopAt : (r : I) -> Path Circle (circleLoop @ r) (circleLoop @ r) := fun r => refl
def loopEnd0 : Path (Path Circle circleBase circleBase) (loopAt i0) refl := refl
def loopEnd1 : Path (Path Circle circleBase circleBase) (loopAt i1) refl := refl
def glue : (A : Type 0) -> (R : A -> A -> Type 0) -> (a : A) -> (b : A) -> R a b -> Path (Quot A R) (quotIn A R a) (quotIn A R b) := fun A R a b r => quotGlue A R a b r
def isSetQuot : (A : Type 0) -> (R : A -> A -> Type 0) -> (x : Quot A R) -> (y : Quot A R) -> (p : Path (Quot A R) x y) -> (q : Path (Quot A R) x y) -> Path (Path (Quot A R) x y) p q := fun A R => quotSquash A R
def transpBase : Path Circle (transp (fun i => Circle) i0 circleBase) circleBase := refl
def loopTwice : Path Circle circleBase circleBase := trans circleLoop circleLoop
def loopTwiceEnd : Path Circle (loopTwice @ i0) circleBase := refl
def base : Circle := circleBase
def pointCount : (n : Nat) -> Nat := fun (n : Nat) => first (fold (fun (acc : Prod Nat Circle) => pair (natAdd (first acc) 1) (second acc)) (pair 0 circleBase) n)
def circleRec : (B : Type 0) -> (b : B) -> (l : Path B b b) -> Circle -> B := fun B b l x => fold b l x
def truncRec : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (pr : isProp B) -> Trunc A -> B := fun A B f pr x => fold f pr x
def quotRec : (A : Type 0) -> (R : A -> A -> Type 0) -> (B : Type 0) -> (f : A -> B) -> (g : (a : A) -> (b : A) -> R a b -> Path B (f a) (f b)) -> (st : isSet B) -> Quot A R -> B := fun A R B f g st x => fold f g st x
def circleRecBase : (B : Type 0) -> (b : B) -> (l : Path B b b) -> Path B (circleRec B b l circleBase) b := fun B b l => refl
def circleRecLoop : (B : Type 0) -> (b : B) -> (l : Path B b b) -> (i : I) -> Path B (circleRec B b l (circleLoop @ i)) (l @ i) := fun B b l i => refl
def circleRecTwice : (B : Type 0) -> (b : B) -> (l : Path B b b) -> (i : I) -> Path B (circleRec B b l (loopTwice @ i)) ((trans l l) @ i) := fun B b l i => refl
def quotRecGlue : (A : Type 0) -> (R : A -> A -> Type 0) -> (B : Type 0) -> (f : A -> B) -> (g : (a : A) -> (b : A) -> R a b -> Path B (f a) (f b)) -> (st : isSet B) -> (a : A) -> (b : A) -> (r : R a b) -> (i : I) -> Path B (quotRec A R B f g st (quotGlue A R a b r @ i)) (g a b r @ i) := fun A R B f g st a b r i => refl
def quotRecSquash : (A : Type 0) -> (R : A -> A -> Type 0) -> (B : Type 0) -> (f : A -> B) -> (g : (a : A) -> (b : A) -> R a b -> Path B (f a) (f b)) -> (st : isSet B) -> (x : Quot A R) -> (y : Quot A R) -> (p : Path (Quot A R) x y) -> (q : Path (Quot A R) x y) -> (i : I) -> (j : I) -> Path B (quotRec A R B f g st (quotSquash A R x y p q @ i @ j)) (st (quotRec A R B f g st x) (quotRec A R B f g st y) (<k> quotRec A R B f g st (p @ k)) (<k> quotRec A R B f g st (q @ k)) @ i @ j) := fun A R B f g st x y p q i j => refl
def three : Nat := circleRec Nat 3 refl circleBase
def truncMap : (A : Type 0) -> (f : A -> A) -> Trunc A -> Trunc A := fun A f x => truncRec A (Trunc A) (fun a => truncIn A (f a)) (truncSquash A) x
def truncMapped : Trunc Nat := truncMap Nat (fun a => natAdd a 1) (truncIn Nat 2)
def quotMap : (A : Type 0) -> (R : A -> A -> Type 0) -> (f : A -> A) -> (fr : (a : A) -> (b : A) -> R a b -> R (f a) (f b)) -> Quot A R -> Quot A R := fun A R f fr x => quotRec A R (Quot A R) (fun a => quotIn A R (f a)) (fun a b r => quotGlue A R (f a) (f b) (fr a b r)) (quotSquash A R) x
def quotMapped : Quot Nat (fun a b => Eq Nat a b) := quotMap Nat (fun a b => Eq Nat a b) (fun a => natAdd a 1) (fun a b r => cong (fun a => natAdd a 1) r) (quotIn Nat (fun a b => Eq Nat a b) 2)
def circleCount : (n : Nat) -> Nat := fun (n : Nat) => first (fold (fun (acc : Prod Nat Circle) => pair (natAdd (first acc) (fold 1 refl (second acc))) (second acc)) (pair 0 circleBase) n)
def truncCount : (n : Nat) -> Nat := fun (n : Nat) => first (fold (fun (acc : Prod Nat (Trunc Nat)) => pair (natAdd (first acc) 1) (fold (fun (a : Nat) => truncIn Nat (natAdd a 1)) (truncSquash Nat) (second acc))) (pair 0 (truncIn Nat 0)) n)
