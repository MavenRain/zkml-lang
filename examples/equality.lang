-- Formers F12 and F13: equality, transport and congruence.
def price : Nat := 1200
def fee : Nat := 1200
def same : Eq Nat price fee := refl
def back : Eq Nat fee price := symm same
def round : Eq Nat price price := trans same back
def moved : (P : (n : Nat) -> Type 0) -> (u : P price) -> P fee :=
  fun (P : (n : Nat) -> Type 0) (u : P price) => transport P same u
def bumped : Eq Nat (natAdd price 1) (natAdd fee 1) := cong (fun (n : Nat) => natAdd n 1) same
